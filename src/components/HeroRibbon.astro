---
// Full-width hero backdrop: a lit, twisting silk ribbon rendered with WebGL.
// The ribbon is a 3D strip along a curve; as it twists, the side facing you is bright,
// the folds darken, a soft highlight runs along them and the back shows a second colour.
// On load it sweeps in from the top, then keeps slowly turning.
// Pauses when off-screen or when the tab is hidden; reduced motion draws one still frame.
// Without WebGL a soft CSS gradient stands in.
---

<div class="hero-bg" aria-hidden="true">
  <canvas class="ribbon" data-ribbon></canvas>
  <div class="ribbon-fallback"></div>
  <div class="guides"></div>
</div>

<script>
  const VERTEX = `
    attribute vec2 aUv;
    uniform float uTime;
    uniform float uAspect;
    uniform float uWidth;
    uniform vec2 uP0;
    uniform vec2 uP1;
    uniform vec2 uP2;
    uniform vec2 uP3;
    varying vec2 vUv;
    varying float vFacing;
    varying float vDiffuse;
    varying float vSpecular;

    vec2 curve(float s) {
      float u = 1.0 - s;
      return u * u * u * uP0 + 3.0 * u * u * s * uP1 + 3.0 * u * s * s * uP2 + s * s * s * uP3;
    }

    vec2 tangent(float s) {
      float u = 1.0 - s;
      return 3.0 * u * u * (uP1 - uP0) + 6.0 * u * s * (uP2 - uP1) + 3.0 * s * s * (uP3 - uP2);
    }

    void main() {
      float s = aUv.x;
      float v = aUv.y - 0.5;
      vec2 t = normalize(tangent(s));
      vec2 n = vec2(-t.y, t.x);

      // Twist angle along the ribbon, drifting over time.
      // Rolls back and forth (never fully edge-on), so it folds softly instead of pinching.
      float twist = 1.05 * sin(s * 3.4 - uTime * 0.42) + 0.3 * sin(s * 7.0 + uTime * 0.3);
      float width = uWidth * (0.82 + 0.22 * sin(s * 2.6 + uTime * 0.27));
      float sway = sin(s * 4.0 + uTime * 0.5) * 0.008;

      vec2 p = curve(s) + n * (v * width * cos(twist) + sway);

      // Surface normal in 3D (x right, y down, z towards the viewer).
      // The cross-section is slightly curved, so light varies across the width (silk sheen).
      float curl = v * 1.6;
      vec3 normal = normalize(vec3(-n * sin(twist + curl), cos(twist + curl)));
      if (normal.z < 0.0) normal = -normal;
      vec3 light = normalize(vec3(-0.45, -0.55, 0.7));
      vec3 halfway = normalize(light + vec3(0.0, 0.0, 1.0));

      vFacing = cos(twist);
      vDiffuse = max(dot(normal, light), 0.0);
      vSpecular = pow(max(dot(normal, halfway), 0.0), 22.0);
      vUv = aUv;
      gl_Position = vec4(p.x / uAspect * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0);
    }
  `;

  const FRAGMENT = `
    precision highp float;
    uniform float uReveal;
    varying vec2 vUv;
    varying float vFacing;
    varying float vDiffuse;
    varying float vSpecular;

    vec3 sky = vec3(0.42, 0.80, 1.00);
    vec3 indigo = vec3(0.45, 0.47, 1.00);
    vec3 violet = vec3(0.62, 0.42, 1.00);
    vec3 lilac = vec3(0.90, 0.60, 1.00);
    vec3 teal = vec3(0.30, 0.86, 0.80);

    vec3 front(float x) {
      if (x < 0.3) return mix(sky, indigo, x / 0.3);
      if (x < 0.65) return mix(indigo, violet, (x - 0.3) / 0.35);
      return mix(violet, lilac, (x - 0.65) / 0.35);
    }

    vec3 back(float x) {
      return mix(teal, sky, x);
    }

    void main() {
      float s = vUv.x;
      float v = vUv.y;
      float k = clamp(s * 0.85 + v * 0.3 - 0.05, 0.0, 1.0);

      vec3 colour = vFacing > 0.0 ? front(k) : back(k) * 0.95;
      float facing = abs(vFacing);

      // Light: ambient + diffuse, then a soft white highlight.
      colour *= 0.72 + 0.38 * vDiffuse;
      colour *= 0.78 + 0.22 * facing;
      colour += vec3(vSpecular) * 0.55;

      // Fine silk threads, faded out where the ribbon is edge-on.
      float threads = sin(v * 700.0 + sin(s * 30.0) * 1.5);
      colour *= 1.0 + threads * 0.03 * facing;

      // Soft edges, soft sweep-in front.
      float edge = smoothstep(0.0, 0.05, v) * smoothstep(1.0, 0.95, v);
      float ends = smoothstep(0.0, 0.04, s) * smoothstep(1.0, 0.94, s);
      float reveal = smoothstep(uReveal, uReveal - 0.08, s);
      float alpha = 0.94 * edge * ends * reveal;

      gl_FragColor = vec4(clamp(colour, 0.0, 1.0) * alpha, alpha);
    }
  `;

  const canvas = document.querySelector<HTMLCanvasElement>("[data-ribbon]");
  const gl = canvas?.getContext("webgl", { alpha: true, antialias: true, premultipliedAlpha: true });

  const compile = (context: WebGLRenderingContext, type: number, source: string) => {
    const shader = context.createShader(type)!;
    context.shaderSource(shader, source);
    context.compileShader(shader);
    if (!context.getShaderParameter(shader, context.COMPILE_STATUS)) {
      throw new Error(context.getShaderInfoLog(shader) ?? "shader error");
    }
    return shader;
  };

  const setup = () => {
    if (!canvas || !gl) return false;
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl, gl.VERTEX_SHADER, VERTEX));
    gl.attachShader(program, compile(gl, gl.FRAGMENT_SHADER, FRAGMENT));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return false;
    gl.useProgram(program);

    // Grid of points along (s) and across (v) the ribbon.
    const ALONG = 220;
    const ACROSS = 24;
    const uv: number[] = [];
    for (let i = 0; i <= ALONG; i++) {
      for (let j = 0; j <= ACROSS; j++) uv.push(i / ALONG, j / ACROSS);
    }
    const indices: number[] = [];
    for (let i = 0; i < ALONG; i++) {
      for (let j = 0; j < ACROSS; j++) {
        const a = i * (ACROSS + 1) + j;
        const b = a + ACROSS + 1;
        indices.push(a, b, a + 1, b, b + 1, a + 1);
      }
    }

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(uv), gl.STATIC_DRAW);
    const location = gl.getAttribLocation(program, "aUv");
    gl.enableVertexAttribArray(location);
    gl.vertexAttribPointer(location, 2, gl.FLOAT, false, 0, 0);
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(indices), gl.STATIC_DRAW);

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    const u = (name: string) => gl.getUniformLocation(program, name);
    const uniforms = {
      time: u("uTime"), aspect: u("uAspect"), width: u("uWidth"), reveal: u("uReveal"),
      p0: u("uP0"), p1: u("uP1"), p2: u("uP2"), p3: u("uP3"),
    };

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const INTRO = 2400;

    // Curve control points in units of canvas height (x from 0 to aspect, y downwards).
    const layout = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      gl.viewport(0, 0, canvas.width, canvas.height);

      const aspect = width / height;
      const narrow = width < 760;
      const points = narrow
        ? [[0.7, -0.15], [1.05, 0.25], [0.6, 0.6], [1.15, 1.05]]
        : [[0.64, -0.22], [0.84, 0.26], [0.8, 0.6], [1.1, 1.16]];
      [uniforms.p0, uniforms.p1, uniforms.p2, uniforms.p3].forEach((slot, i) => {
        gl.uniform2f(slot, points[i][0] * aspect, points[i][1]);
      });
      gl.uniform1f(uniforms.aspect, aspect);
      gl.uniform1f(uniforms.width, Math.max(220, Math.min(width, 1600) * 0.3) / height);
    };

    const draw = (seconds: number, reveal: number) => {
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform1f(uniforms.time, seconds);
      gl.uniform1f(uniforms.reveal, reveal);
      gl.drawElements(gl.TRIANGLES, indices.length, gl.UNSIGNED_SHORT, 0);
    };

    const ease = (x: number) => 1 - Math.pow(1 - x, 3);
    let running = false;
    let frame = 0;
    let begin = 0;
    let clock = 0;
    let previous = 0;

    const loop = (now: number) => {
      if (!begin) begin = now;
      if (previous) clock += Math.min(now - previous, 50);
      previous = now;
      draw(clock / 1000, 0.1 + 1.0 * ease(Math.min(1, (now - begin) / INTRO)));
      if (running) frame = requestAnimationFrame(loop);
    };

    const start = () => {
      if (running || reduce) return;
      running = true;
      previous = 0;
      frame = requestAnimationFrame(loop);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    layout();
    if (reduce) draw(0, 1.2);

    window.addEventListener("resize", () => {
      layout();
      if (!running) draw(clock / 1000, 1.2);
    });

    if (!reduce) {
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(canvas);
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    }
    return true;
  };

  let ok = false;
  try {
    ok = setup();
  } catch {
    ok = false;
  }
  if (!ok) canvas?.closest(".hero-bg")?.classList.add("no-webgl");
</script>

<style>
  .hero-bg {
    position: absolute;
    top: -72px;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    margin-left: -50vw;
    overflow: hidden;
    pointer-events: none;
  }

  .ribbon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.js-anim) .ribbon {
    animation: ribbon-in 1s ease both;
  }

  @keyframes ribbon-in {
    from { opacity: 0; }
  }

  .ribbon-fallback {
    display: none;
  }

  .no-webgl .ribbon {
    display: none;
  }

  .no-webgl .ribbon-fallback {
    display: block;
    position: absolute;
    top: -20%;
    right: -10%;
    width: 55%;
    height: 140%;
    background: linear-gradient(160deg, #38bdf8, #4f46e5 40%, #7c3aed 70%, #c084fc);
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.5;
    transform: rotate(-28deg);
  }

  /* Faint vertical guide lines at the content edges. */
  .guides {
    position: absolute;
    inset: 0;
    width: min(calc(100% - 48px), 1200px);
    margin-inline: auto;
    border-inline: 1px dashed rgba(31, 48, 71, 0.08);
  }

  @media (max-width: 960px) {
    .ribbon { opacity: 0.4; }
  }
</style>
