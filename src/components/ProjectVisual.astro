---
// Illustrations shown in place of project screenshots until real media is added.
// Each one plays a short sequence once when scrolled into view (motion.ts adds .is-playing);
// the AI one is a looping agent run (AgentRun).
interface Props {
  kind: "ai" | "platform" | "iot" | "identity" | "research" | "agri" | "web";
}

import AgentRun from "./AgentRun.astro";

const { kind } = Astro.props;

const pipeline = [
  { name: "Proxmox", role: "VMs" },
  { name: "Terraform", role: "Provision" },
  { name: "Ansible", role: "Configure" },
  { name: "Kubernetes", role: "Deploy" },
];
---

<div class:list={["pv", `pv--${kind}`]} data-play aria-hidden="true">

  {kind === "ai" && <AgentRun />}

  {kind === "web" && (
    <div class="web">
      <div class="browser">
        <div class="browser-bar">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url">racoona.ai</span>
        </div>
        <div class="page">
          <div class="page-nav" data-step style="--d: 0s">
            <span class="logo">RACOONA.</span>
            <span class="nav-lines"><i></i><i></i><i></i></span>
          </div>
          <div class="page-hero">
            <span class="bar bar-xl" data-step style="--d: 0.25s"></span>
            <span class="bar bar-l" data-step style="--d: 0.4s"></span>
            <span class="bar bar-text" data-step style="--d: 0.55s"></span>
            <span class="btn" data-step style="--d: 0.7s"></span>
          </div>
          <div class="page-cards">
            <span data-step style="--d: 0.85s"></span>
            <span data-step style="--d: 0.95s"></span>
            <span data-step style="--d: 1.05s"></span>
          </div>
          <div class="form" data-step style="--d: 1.25s">
            <span class="field"></span>
            <span class="field"></span>
            <span class="send">Send</span>
          </div>
        </div>
      </div>
      <div class="toast" data-step style="--d: 2.1s">
        <span class="ok">✓</span>
        <span><strong>Message delivered</strong><small>Contact form → email</small></span>
      </div>
    </div>
  )}

  {kind === "platform" && (
    <div class="platform">
      <div class="stages">
        {pipeline.map((stage, i) => (
          <div class="stage" data-step style={`--d: ${0.2 + i * 0.5}s`}>
            <span class="stage-index">{String(i + 1).padStart(2, "0")}</span>
            <strong>{stage.name}</strong>
            <small>{stage.role}</small>
          </div>
        ))}
        <span class="track"><span class="track-fill"></span></span>
      </div>
      <div class="monitor" data-step style="--d: 2.2s">
        <div class="monitor-head">
          <span>Prometheus · Grafana</span>
          <span class="healthy" data-step style="--d: 3.4s">● healthy</span>
        </div>
        <svg viewBox="0 0 320 90" preserveAspectRatio="none">
          <path class="grid" d="M0 22H320M0 45H320M0 68H320" />
          <path class="area" d="M0 70 L32 62 L64 66 L96 48 L128 52 L160 38 L192 44 L224 30 L256 34 L288 26 L320 28 L320 90 L0 90Z" />
          <path class="line" pathLength="1" d="M0 70 L32 62 L64 66 L96 48 L128 52 L160 38 L192 44 L224 30 L256 34 L288 26 L320 28" />
        </svg>
      </div>
    </div>
  )}

  {kind !== "ai" && kind !== "web" && kind !== "platform" && (
    <div class="simple">
      <strong>{kind}</strong>
    </div>
  )}
</div>

<style>
  .pv {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 340px;
    padding: 34px 28px;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, #d6e2ef 1px, transparent 0) 0 0 / 18px 18px,
      linear-gradient(160deg, #f5f9fd, #eef4fa);
    font-family: var(--mono);
  }

  .pv > div {
    width: 100%;
    max-width: 460px;
  }

  .tag {
    display: inline-block;
    color: #60758b;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tag-accent {
    color: var(--accent);
  }

  .ok {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sage);
    color: #fff;
    font-size: 11px;
  }

  /* Website */
  .web {
    position: relative;
    padding-bottom: 18px;
  }

  .browser {
    overflow: hidden;
    background: #fff;
    border: 1px solid #d3dfec;
    border-radius: 12px;
    box-shadow: 0 24px 40px -30px rgba(38, 56, 77, 0.6);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    background: #f3f7fb;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cfdbe8;
  }

  .url {
    flex: 1;
    max-width: 200px;
    padding: 3px 10px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: #60758b;
    font-size: 11px;
  }

  .page {
    display: grid;
    gap: 14px;
    padding: 16px 18px 18px;
  }

  .page-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    color: var(--accent);
    font: 800 13px/1 "Inter Variable", Inter, sans-serif;
    letter-spacing: 0.04em;
  }

  .nav-lines {
    display: flex;
    gap: 8px;
  }

  .nav-lines i,
  .bar,
  .field {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: #dbe5f0;
  }

  .nav-lines i {
    width: 26px;
  }

  .page-hero {
    display: grid;
    gap: 7px;
  }

  .bar-xl { width: 78%; height: 12px; background: #26384d; }
  .bar-l { width: 56%; height: 12px; background: #26384d; }
  .bar-text { width: 64%; margin-top: 4px; }

  .btn {
    width: 72px;
    height: 20px;
    margin-top: 6px;
    border-radius: 5px;
    background: var(--accent);
  }

  .page-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .page-cards span {
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #f7fafd;
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 10px;
    border: 1px dashed #c6d6e7;
    border-radius: 8px;
  }

  .field {
    height: 18px;
    background: #f1f5fa;
    border: 1px solid var(--line);
  }

  .send {
    padding: 3px 10px;
    border-radius: 5px;
    background: #26384d;
    color: #fff;
    font-size: 10.5px;
  }

  .toast {
    position: absolute;
    right: -6px;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    background: #fff;
    border: 1px solid #c9dfd0;
    border-radius: 10px;
    box-shadow: 0 16px 30px -18px rgba(38, 56, 77, 0.55);
  }

  .toast strong {
    display: block;
    color: var(--ink);
    font: 600 13px/1.2 "Inter Variable", Inter, sans-serif;
  }

  .toast small {
    color: #60758b;
    font-size: 10.5px;
  }

  /* Platform */
  .platform {
    display: grid;
    gap: 18px;
  }

  .stages {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding-bottom: 14px;
  }

  .stage {
    padding: 10px;
    background: #fff;
    border: 1px solid #d3dfec;
    border-radius: 10px;
    text-align: center;
  }

  .stage-index {
    color: var(--accent);
    font-size: 10px;
  }

  .stage strong {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font: 600 13px/1.3 "Inter Variable", Inter, sans-serif;
  }

  .stage small {
    color: #60758b;
    font-size: 10px;
  }

  .track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background: #dbe5f0;
  }

  .track-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--accent), var(--sage));
    transform-origin: left;
  }

  .monitor {
    padding: 12px 14px 8px;
    background: #fff;
    border: 1px solid #d3dfec;
    border-radius: 12px;
  }

  .monitor-head {
    display: flex;
    justify-content: space-between;
    color: #60758b;
    font-size: 11px;
  }

  .healthy {
    color: var(--sage);
  }

  .monitor svg {
    display: block;
    width: 100%;
    height: 90px;
    margin-top: 6px;
  }

  .grid {
    stroke: #edf2f7;
    stroke-width: 1;
  }

  .area {
    fill: rgba(63, 120, 184, 0.08);
  }

  .line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }

  .simple {
    color: #60758b;
    text-align: center;
    text-transform: capitalize;
  }

  /* Motion: hidden only when JS enables animation; each visual plays once. */
  :global(.js-anim) .pv [data-step] {
    opacity: 0;
  }

  :global(.js-anim) .pv .track-fill {
    transform: scaleX(0);
  }

  :global(.js-anim) .pv .line {
    stroke-dashoffset: 1;
  }

  :global(.js-anim) .pv .area {
    opacity: 0;
  }

  .pv:global(.is-playing) [data-step] {
    animation: pv-rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }

  .pv:global(.is-playing) .toast,
  .pv:global(.is-playing) .healthy {
    animation: pv-pop 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) var(--d, 0s) both;
  }

  .pv:global(.is-playing) .stage {
    animation: pv-rise 0.45s ease var(--d, 0s) both, pv-lit 0.4s ease calc(var(--d, 0s) + 0.25s) forwards;
  }

  .pv:global(.is-playing) .track-fill {
    animation: pv-fill 2s cubic-bezier(0.45, 0, 0.25, 1) 0.2s both;
  }

  .pv:global(.is-playing) .line {
    animation: pv-draw 1.2s ease 2.4s both;
  }

  .pv:global(.is-playing) .area {
    animation: pv-fade 0.8s ease 3s both;
  }

  @keyframes pv-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes pv-pop {
    from { opacity: 0; transform: scale(0.9) translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes pv-lit {
    to { border-color: #9bbbe0; background: #f2f8fe; }
  }

  @keyframes pv-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes pv-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes pv-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 520px) {
    .pv { padding: 18px; }
    .stages { grid-template-columns: repeat(2, 1fr); }
    .toast { right: 0; }
  }
</style>
