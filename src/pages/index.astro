---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaFrame from "../components/MediaFrame.astro";

const base = import.meta.env.BASE_URL;

const featuredWork = [
  {
    title: "AI-Powered Infrastructure Generation",
    context: "Client work",
    problem: "Infrastructure requests needed to become reliable, context-aware deployments without repeating manual setup.",
    built: "A multi-agent system using LLMs and RAG to generate Terraform, deploy to AWS, validate the result and run post-deployment checks.",
    result: "A connected workflow from infrastructure request through validated AWS deployment.",
    visual: "ai",
    stack: ["Python", "LangGraph", "Ollama", "RAG", "AWS", "Terraform"],
  },
  {
    title: "Racoona",
    context: "Client work · live site",
    problem: "The business needed a fast static website with a dependable way for visitors to make contact.",
    built: "Built and maintained the Astro site with contact forms and Web3Forms email delivery.",
    result: "A lightweight, live website with working contact delivery.",
    visual: "web",
    stack: ["Astro", "Web3Forms", "Email delivery"],
    href: "https://racoona.ai/",
  },
  {
    title: "Peracom Internal Developer Platform",
    context: "Platform engineering",
    problem: "Provisioning and deployment across infrastructure needed a repeatable path with observability.",
    built: "Automated provisioning and deployment with Proxmox, Terraform, Ansible and Kubernetes, with Prometheus and Grafana monitoring.",
    result: "A repeatable internal platform workflow with monitoring in place.",
    visual: "platform",
    stack: ["Proxmox", "Terraform", "Ansible", "Kubernetes", "Prometheus", "Grafana"],
  },
];

const moreWork = [
  { title: "GloveXcel", description: "IoT rehabilitation glove with sensor processing, BLE communication and web APIs.", tags: ["ESP32", "BLE", "React", "Node.js"], href: "https://github.com/cepdnaclk/e21-3yp-GloveXcel" },
  { title: "FreeIPA migration", description: "Moved legacy OpenLDAP to centralized FreeIPA on AlmaLinux 9 with Podman and Keycloak SSO.", tags: ["FreeIPA", "Keycloak", "Podman"], visual: "identity" },
  { title: "Agrimate", description: "Bilingual farmer-to-customer marketplace with crop-care advice and delivery routing.", tags: ["Flutter", "Node.js", "Firebase"], visual: "agri" },
];

const pullRequests = [
  ["pypa/build", "1281", "Fixed the getting-started tutorial command.", "https://github.com/pypa/build/pull/1281"],
  ["pypa/build", "1282", "Replaced retired macOS runners in the CI guide.", "https://github.com/pypa/build/pull/1282"],
  ["pypa/build", "1283", "Corrected the build-failure hint when isolation is disabled, with tests.", "https://github.com/pypa/build/pull/1283"],
  ["terrakube", "3921", "Fixed the telemetry Docker Compose guide.", "https://github.com/terrakube-io/terrakube/pull/3921"],
  ["terrakube", "3922", "Fixed repository URL parsing for names and hosts containing .git, with tests.", "https://github.com/terrakube-io/terrakube/pull/3922"],
];
---

<BaseLayout
  title="Chanuth Abeynayake — Freelance DevOps & AI automation engineer"
  description="Freelance DevOps and AI automation engineer building reliable cloud infrastructure, automation and fast business websites."
>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href={`${base}#top`} aria-label="Chanuth Abeynayake home">CA<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#services">Services</a><a href="#work">Work</a><a href="#process">Process</a><a href="#contact">Contact</a>
      </nav>
      <a class="nav-cta" href="#contact">Get a quote <span>↗</span></a>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="hero-copy">
          <p class="eyebrow">FREELANCE DEVOPS & AI AUTOMATION ENGINEER</p>
          <h1>I build cloud infrastructure and AI automation for startups and small teams.</h1>
          <p class="hero-description">Reliable deployments, less manual work and practical systems that your team can understand and maintain.</p>
          <div class="hero-actions"><a class="button button-primary" href="#contact">Get a quote <span>↗</span></a><a class="button button-secondary" href="#work">See my work <span>↓</span></a></div>
          <p class="trust-line">Code merged into PyPA build and Terrakube · Client work for Racoona</p>
        </div>
        <div class="hero-visual" aria-label="AI to deployment workflow illustration">
          <div class="flow-label">AI → INFRASTRUCTURE → DEPLOYMENT</div>
          <div class="flow-node"><span>01</span><strong>Understand</strong><small>LLM + RAG context</small></div>
          <div class="flow-line"></div>
          <div class="flow-node active"><span>02</span><strong>Generate</strong><small>Terraform configuration</small></div>
          <div class="flow-line"></div>
          <div class="flow-node"><span>03</span><strong>Validate</strong><small>AWS checks and handover</small></div>
        </div>
      </section>

      <section class="credibility" aria-label="Credibility">
        <div><strong>5</strong><span>merged open-source PRs<br />PyPA build · Terrakube</span></div>
        <div><strong>Client</strong><span>Racoona<br />static Astro site</span></div>
        <div><strong>3×</strong><span>hackathon finalist<br />team lead</span></div>
      </section>

      <section class="section" id="services">
        <div class="section-heading"><div><p class="eyebrow">01 / SERVICES</p><h2>Technical work that moves the business forward.</h2></div><p>Choose a focused engagement or combine services around one outcome.</p></div>
        <div class="service-grid">
          <article class="card service-card"><p class="card-label">CLOUD & DEVOPS</p><h3>Cloud & DevOps setup</h3><p>For teams that need a dependable path from infrastructure to production.</p><ul><li>Terraform on AWS</li><li>Kubernetes and CI/CD</li><li>Prometheus/Grafana monitoring</li><li>Linux, FreeIPA and Keycloak SSO</li></ul><strong>Scoped delivery: typically 2–6 weeks</strong></article>
          <article class="card service-card"><p class="card-label">AI AUTOMATION</p><h3>AI automation</h3><p>For teams connecting useful AI to real infrastructure, workflows and data.</p><ul><li>LLM agents and orchestration</li><li>RAG pipelines with LangGraph and Ollama</li><li>Infrastructure and data integrations</li><li>Validation and operational checks</li></ul><strong>Scoped delivery: typically 2–6 weeks</strong></article>
          <article class="card service-card"><p class="card-label">BUSINESS WEBSITES</p><h3>Business websites</h3><p>For businesses that need a fast, clear site that turns visits into conversations.</p><ul><li>Astro static sites</li><li>Responsive, accessible UI</li><li>Contact forms</li><li>Email delivery with Web3Forms</li></ul><strong>Scoped delivery: typically 1–3 weeks</strong></article>
        </div>
      </section>

      <section class="section" id="work">
        <div class="section-heading"><div><p class="eyebrow">02 / FEATURED WORK</p><h2>Proof in the work.</h2></div><p>Client delivery and platform engineering grounded in real systems.</p></div>
        <div class="case-studies">{featuredWork.map((project, index) => <article class:list={["case-study", index % 2 ? "case-study-reverse" : ""]}><MediaFrame kind="image" ratio="16/10" alt={`${project.title} system illustration`} visual={project.visual} /><div class="case-copy"><p class="card-label">{project.context}</p><h3>{project.title}</h3><dl><div><dt>Problem</dt><dd>{project.problem}</dd></div><div><dt>Built</dt><dd>{project.built}</dd></div><div><dt>Result</dt><dd>{project.result}</dd></div></dl><div class="tag-list">{project.stack.map((tag) => <span>{tag}</span>)}</div>{project.href && <a class="inline-link" href={project.href} target="_blank" rel="noreferrer">Visit live site ↗</a>}</div></article>)}</div>
        <div class="more-work"><h3>More projects</h3>{moreWork.map((project) => <article><div><h4>{project.title}</h4><p>{project.description}</p></div><div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div>{project.href && <a class="inline-link" href={project.href} target="_blank" rel="noreferrer">Repository ↗</a>}</article>)}</div>
      </section>

      <section class="section open-source" id="open-source">
        <div class="section-heading"><div><p class="eyebrow">03 / OPEN SOURCE</p><h2>Comfortable in other people's codebases.</h2></div><p>Five merged fixes, reviewed and shipped to existing project standards.</p></div>
        <div class="pr-list">{pullRequests.map(([repo, number, description, href], index) => <a class="pr-row" href={href} target="_blank" rel="noreferrer"><span>{String(index + 1).padStart(2, "0")}</span><strong>{repo} #{number}</strong><p>{description}</p><em>Merged ↗</em></a>)}</div>
      </section>

      <section class="section process" id="process">
        <div class="section-heading"><div><p class="eyebrow">04 / PROCESS</p><h2>A clear path from first conversation to handover.</h2></div></div>
        <div class="process-grid">{["Intro call", "Proposal and fixed scope", "Build with regular updates", "Handover with documentation"].map((step, index) => <article><span>0{index + 1}</span><h3>{step}</h3></article>)}</div>
        <p class="availability">Response within 24 hours · Based in Sri Lanka (UTC+5:30) · Overlap with Europe and US mornings</p>
        <p class="education">Computer Engineering undergraduate at the University of Peradeniya.</p>
      </section>

      <section class="contact-panel" id="contact">
        <div><p class="eyebrow">05 / CONTACT</p><h2>Have a system to improve?</h2><p>Tell me what you need, and I’ll reply with the next sensible step.</p><a class="contact-email" href="mailto:chanuth412@gmail.com">chanuth412@gmail.com ↗</a><div class="social-links"><a href="https://github.com/Chanuth412-pixel" target="_blank" rel="noreferrer">GitHub ↗</a></div></div>
        <form class="contact-form" data-contact-form>
          <label>Name<input name="name" required /></label><label>Email<input type="email" name="email" required /></label><label>What do you need?<textarea name="need" rows="4" required></textarea></label><label>Budget range<select name="budget"><option value="">Select a range</option><option>To discuss</option><option>Under $1,000</option><option>$1,000–$3,000</option><option>$3,000+</option></select></label><label>Timeline<select name="timeline"><option value="">Select a timeline</option><option>As soon as possible</option><option>Within 1 month</option><option>Flexible</option></select></label><button class="button button-light" type="submit">Send enquiry ↗</button><p class="form-status" role="status" data-form-status></p>
        </form>
      </section>
    </main>
    <footer class="site-footer"><a class="brand" href={`${base}#top`}>CA<span>.</span></a><a href="mailto:chanuth412@gmail.com">chanuth412@gmail.com</a><a href="https://github.com/Chanuth412-pixel" target="_blank" rel="noreferrer">GitHub</a><a href={`${base}cv.pdf`} download>CV</a><small>© {new Date().getFullYear()} Chanuth Abeynayake</small></footer>
  </div>
</BaseLayout>

<script>
  import { initPortfolioMotion } from "../scripts/motion";
  const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
  // TODO(chanuth): Add PUBLIC_WEB3FORMS_ACCESS_KEY to enable Web3Forms submissions.

  initPortfolioMotion();

  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-form-status]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    const data = new FormData(form);
    if (!accessKey) {
      const subject = encodeURIComponent("Project enquiry from portfolio");
      const body = encodeURIComponent(
        `Name: ${data.get("name")}\nEmail: ${data.get("email")}\nWhat I need: ${data.get("need")}\nBudget: ${data.get("budget")}\nTimeline: ${data.get("timeline")}`
      );
      window.location.href = `mailto:chanuth412@gmail.com?subject=${subject}&body=${body}`;
      status.textContent = "Opening your email client…";
      return;
    }

    data.append("access_key", accessKey);
    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      if (!response.ok) throw new Error("Web3Forms request failed");
      form.reset();
      status.textContent = "Thanks — your enquiry has been sent.";
    } catch (error) {
      console.error(error);
      status.textContent = "Something went wrong. Please email chanuth412@gmail.com directly.";
    }
  });
</script>
