
---
import "@fontsource-variable/inter";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Chanuth Abeynayake — Freelance DevOps & AI automation engineer",
  description = "Freelance DevOps and AI automation engineer building reliable cloud infrastructure, automation and fast business websites."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBFDFF" />
    <meta name="color-scheme" content="light" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}og-preview.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${import.meta.env.BASE_URL}og-preview.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Chanuth Abeynayake",
      email: "chanuth412@gmail.com",
      address: { "@type": "PostalAddress", addressCountry: "Sri Lanka" },
      url: "https://github.com/Chanuth412-pixel",
      sameAs: ["https://github.com/Chanuth412-pixel"],
      knowsAbout: ["DevOps", "AI automation", "Cloud infrastructure"]
    })} />

    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        document.documentElement.classList.add("js-anim");
      }
    </script>

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
