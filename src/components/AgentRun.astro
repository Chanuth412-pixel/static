---
// Project illustration: one run of the multi-agent infrastructure generator, on a loop.
// request types in → orchestrator plans → RAG + LLM agents work in parallel →
// Terraform types out → validate / plan / apply → deployed. Then it starts again.
// The HTML below is the finished state, so without JS (or with reduced motion) it shows
// a complete run; the script resets and replays it while it is on screen.

// main.tf, pre-split into highlighted tokens so it can be typed out character by character.
const code: [string, string][][] = [
  [["kw", "resource"], ["", " "], ["str", '"aws_instance"'], ["", " "], ["str", '"api"'], ["", " {"]],
  [["", "  "], ["attr", "ami"], ["", "           = "], ["ref", "data.aws_ami.ubuntu.id"]],
  [["", "  "], ["attr", "instance_type"], ["", " = "], ["ref", "var.size"]],
  [["", "  "], ["attr", "subnet_id"], ["", "     = "], ["ref", "aws_subnet.private.id"]],
  [["", "  "], ["attr", "tags"], ["", "          = { env = "], ["str", '"staging"'], ["", " }"]],
  [["", "}"]],
];

const html = (line: [string, string][]) =>
  line.map(([kind, text]) => (kind ? `<span class="${kind}">${text}</span>` : text)).join("");

const request = "Staging environment for the API";
const checks = ["validate", "plan", "apply"];
---

<div class="run" data-agent-run>
  <!-- request -->
  <div class="card card-request" data-node="request" data-state="done">
    <span class="avatar" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="3.6" /><path d="M5.5 19a6.5 6.5 0 0 1 13 0" /></svg>
    </span>
    <span class="request-text">
      <span class="label">Request</span>
      <span class="typed" data-request data-full={request}>{request}</span>
    </span>
  </div>

  <svg class="wire" viewBox="0 0 460 22" aria-hidden="true" data-wire="w1">
    <path class="track" d="M230 0 L230 22" />
    <path class="beam" pathLength="1" d="M230 0 L230 22" />
  </svg>

  <!-- orchestrator -->
  <div class="card card-core" data-node="core" data-state="done">
    <div class="card-head">
      <span class="label label-core">LangGraph · orchestrator</span>
      <span class="status"><i class="spin"></i><b class="tick">✓</b><span data-status>routed to 2 agents</span></span>
    </div>
    <strong>Plans the work and routes it to agents</strong>
  </div>

  <svg class="wire" viewBox="0 0 460 28" aria-hidden="true" data-wire="fork">
    <path class="track" d="M230 0 C230 16 112 12 112 28" />
    <path class="track" d="M230 0 C230 16 348 12 348 28" />
    <path class="beam beam-rag" pathLength="1" d="M230 0 C230 16 112 12 112 28" />
    <path class="beam beam-llm" pathLength="1" d="M230 0 C230 16 348 12 348 28" />
  </svg>

  <!-- agents -->
  <div class="agents">
    <div class="card card-agent tone-rag" data-node="rag" data-state="done">
      <div class="card-head">
        <span class="label">RAG agent</span>
        <span class="status"><i class="spin"></i><b class="tick">✓</b></span>
      </div>
      <strong>Project context</strong>
      <small data-status>context ready</small>
      <span class="progress"><span></span></span>
    </div>
    <div class="card card-agent tone-llm" data-node="llm" data-state="done">
      <div class="card-head">
        <span class="label">LLM agent</span>
        <span class="status"><i class="spin"></i><b class="tick">✓</b></span>
      </div>
      <strong>Terraform config</strong>
      <small data-status>config ready</small>
      <span class="progress"><span></span></span>
    </div>
  </div>

  <svg class="wire" viewBox="0 0 460 28" aria-hidden="true" data-wire="join">
    <path class="track" d="M112 0 C112 16 230 12 230 28" />
    <path class="track" d="M348 0 C348 16 230 12 230 28" />
    <path class="beam beam-rag" pathLength="1" d="M112 0 C112 16 230 12 230 28" />
    <path class="beam beam-llm" pathLength="1" d="M348 0 C348 16 230 12 230 28" />
  </svg>

  <!-- generated code -->
  <div class="code" data-node="code" data-state="done">
    <div class="code-tabs">
      <span class="code-tab">main.tf</span>
      <span class="code-gen"><i class="spin"></i>generating</span>
    </div>
    <ol class="code-lines">
      {code.map((line) => (
        <li data-line={JSON.stringify(line)} set:html={html(line)} />
      ))}
    </ol>
  </div>

  <!-- checks and result -->
  <div class="foot">
    <ol class="checks">
      {checks.map((check) => (
        <li data-check data-state="done"><i class="spin"></i><b class="tick">✓</b>{check}</li>
      ))}
    </ol>
    <span class="deployed" data-deployed data-state="done"><b>✓</b> Deployed to AWS</span>
  </div>
</div>

<script>
  type State = "idle" | "active" | "done";

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.querySelectorAll<HTMLElement>("[data-agent-run]").forEach((root) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const node = (name: string) => root.querySelector<HTMLElement>(`[data-node="${name}"]`)!;
    const set = (element: HTMLElement, state: State) => (element.dataset.state = state);
    const status = (element: HTMLElement, text: string) => {
      const target = element.querySelector<HTMLElement>("[data-status]");
      if (target) target.textContent = text;
    };

    const requestText = root.querySelector<HTMLElement>("[data-request]")!;
    const full = requestText.dataset.full ?? "";
    const lines = Array.from(root.querySelectorAll<HTMLElement>("[data-line]"));
    const checks = Array.from(root.querySelectorAll<HTMLElement>("[data-check]"));
    const deployed = root.querySelector<HTMLElement>("[data-deployed]")!;

    // Replays the light streak on a connector.
    const flow = (name: string) => {
      const wire = root.querySelector<SVGElement>(`[data-wire="${name}"]`)!;
      wire.classList.remove("is-flowing");
      void wire.getBoundingClientRect();
      wire.classList.add("is-flowing");
    };

    // Render the first `count` characters of a highlighted line.
    const typeLine = (element: HTMLElement, count: number) => {
      const tokens: [string, string][] = JSON.parse(element.dataset.line ?? "[]");
      let left = count;
      let out = "";
      for (const [kind, text] of tokens) {
        if (left <= 0) break;
        const part = text.slice(0, left).replace(/</g, "&lt;");
        left -= text.length;
        out += kind ? `<span class="${kind}">${part}</span>` : part;
      }
      element.innerHTML = out;
      return tokens.reduce((sum, [, text]) => sum + text.length, 0);
    };

    const reset = () => {
      root.classList.remove("is-done");
      requestText.textContent = "";
      ["request", "core", "rag", "llm", "code"].forEach((name) => set(node(name), "idle"));
      status(node("core"), "waiting");
      status(node("rag"), "waiting");
      status(node("llm"), "waiting");
      lines.forEach((line) => {
        line.innerHTML = "";
        line.classList.remove("is-current");
      });
      checks.forEach((check) => set(check, "idle"));
      set(deployed, "idle");
    };

    let run = 0;

    const cycle = async (id: number) => {
      const live = () => id === run;
      reset();
      await sleep(500);

      // 1. request types in
      set(node("request"), "active");
      for (let i = 1; i <= full.length && live(); i++) {
        requestText.textContent = full.slice(0, i);
        await sleep(32);
      }
      if (!live()) return;
      set(node("request"), "done");
      flow("w1");
      await sleep(450);

      // 2. orchestrator plans
      set(node("core"), "active");
      status(node("core"), "planning…");
      await sleep(900);
      if (!live()) return;
      set(node("core"), "done");
      status(node("core"), "routed to 2 agents");
      flow("fork");
      await sleep(450);

      // 3. agents work in parallel (CSS fills their progress bars)
      set(node("rag"), "active");
      set(node("llm"), "active");
      status(node("rag"), "retrieving docs…");
      status(node("llm"), "writing config…");
      await sleep(1000);
      if (!live()) return;
      set(node("rag"), "done");
      status(node("rag"), "context ready");
      await sleep(500);
      if (!live()) return;
      set(node("llm"), "done");
      status(node("llm"), "config ready");
      flow("join");
      await sleep(450);

      // 4. Terraform types out
      set(node("code"), "active");
      for (const line of lines) {
        line.classList.add("is-current");
        const length = typeLine(line, 0);
        for (let i = 1; i <= length && live(); i += 2) {
          typeLine(line, i);
          await sleep(16);
        }
        if (!live()) return;
        typeLine(line, length);
        line.classList.remove("is-current");
        await sleep(60);
      }
      set(node("code"), "done");
      await sleep(300);

      // 5. validate → plan → apply
      for (const check of checks) {
        if (!live()) return;
        set(check, "active");
        await sleep(650);
        set(check, "done");
        await sleep(120);
      }
      if (!live()) return;
      set(deployed, "done");
      root.classList.add("is-done");

      // 6. hold, then go again
      await sleep(3200);
      if (live()) cycle(id);
    };

    new IntersectionObserver(([entry]) => {
      run += 1;
      if (entry.isIntersecting) cycle(run);
    }, { threshold: 0.35 }).observe(root);
  });
</script>

<style>
  .run {
    --violet: #6d5dfc;
    --teal: #10a37f;
    --blue: #3b82f6;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 460px;
    font-family: var(--mono);
  }

  /* ---------- cards ---------- */
  .card {
    position: relative;
    padding: 11px 14px;
    background: #fff;
    border: 1px solid #dbe3ee;
    border-radius: 11px;
    box-shadow: 0 8px 20px -16px rgba(38, 56, 77, 0.55);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .card strong {
    display: block;
    color: var(--ink);
    font: 600 14px/1.35 var(--font);
  }

  .card small {
    display: block;
    margin-top: 2px;
    color: #60758b;
    font-size: 11px;
  }

  .label {
    color: #6b7f95;
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }

  .card[data-state="active"] {
    border-color: var(--tone, var(--violet));
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--tone, var(--violet)) 14%, transparent),
      0 10px 24px -16px rgba(38, 56, 77, 0.6);
  }

  /* request */
  .card-request {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #eef1ff;
    color: var(--violet);
  }

  .avatar svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .request-text {
    display: grid;
  }

  .typed {
    min-height: 1.4em;
    color: var(--ink);
    font: 500 14px/1.4 var(--font);
  }

  .card-request[data-state="active"] .typed::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    background: var(--violet);
    vertical-align: -2px;
    animation: blink 0.8s steps(2, start) infinite;
  }

  /* orchestrator */
  .card-core {
    --tone: var(--violet);
    background: linear-gradient(180deg, #faf9ff, #fff);
    border-color: #dcd7ff;
  }

  .label-core {
    color: var(--violet);
  }

  /* agents */
  .agents {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tone-rag { --tone: var(--teal); }
  .tone-llm { --tone: var(--blue); }

  .card-agent .label {
    color: var(--tone);
  }

  .progress {
    display: block;
    height: 3px;
    margin-top: 9px;
    overflow: hidden;
    border-radius: 3px;
    background: #edf1f7;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--tone);
    transform-origin: left;
  }

  .card-agent[data-state="idle"] .progress span {
    transform: scaleX(0);
  }

  .card-agent[data-state="active"] .progress span {
    animation: fill 1.4s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .tone-rag[data-state="active"] .progress span {
    animation-duration: 1s;
  }

  /* status pill: spinner while working, tick when done */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #6b7f95;
    font-size: 10.5px;
    white-space: nowrap;
  }

  .spin {
    display: none;
    width: 10px;
    height: 10px;
    border: 1.6px solid color-mix(in srgb, var(--tone, var(--violet)) 25%, transparent);
    border-top-color: var(--tone, var(--violet));
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .tick {
    display: none;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--tone, var(--violet));
    color: #fff;
    font-size: 9px;
    font-weight: 700;
  }

  [data-state="active"] > .card-head .spin,
  [data-state="active"] > .card-head .status .spin,
  [data-state="active"] .code-gen .spin {
    display: inline-block;
  }

  [data-state="done"] > .card-head .tick {
    display: inline-grid;
    animation: pop 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  /* ---------- connectors with light streaks ---------- */
  .wire {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .wire .track {
    fill: none;
    stroke: #d5dcea;
    stroke-width: 2;
  }

  .wire .beam {
    fill: none;
    stroke: var(--violet);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 0.5 2;
    stroke-dashoffset: 0.5;
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--violet) 70%, transparent));
  }

  .wire .beam-rag { stroke: var(--teal); }
  .wire .beam-llm { stroke: var(--blue); }

  .wire.is-flowing .beam {
    animation: beam 0.55s cubic-bezier(0.45, 0, 0.4, 1) both;
  }

  /* ---------- code ---------- */
  .code {
    overflow: hidden;
    background: #111c30;
    border: 1px solid #1f2d47;
    border-radius: 11px;
    box-shadow: 0 18px 30px -22px rgba(17, 28, 48, 0.9);
    transition: box-shadow 0.4s ease;
  }

  .code[data-state="active"] {
    box-shadow:
      0 0 0 4px rgba(109, 93, 252, 0.16),
      0 18px 30px -22px rgba(17, 28, 48, 0.9);
  }

  .code-tabs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    background: #0c1526;
    border-bottom: 1px solid #1f2d47;
  }

  .code-tab {
    padding: 8px 2px 7px;
    border-bottom: 2px solid #8f7bff;
    color: #dbe4f3;
    font-size: 11px;
  }

  .code-gen {
    --tone: #8f7bff;
    display: none;
    align-items: center;
    gap: 6px;
    color: #a99cff;
    font-size: 10.5px;
  }

  .code[data-state="active"] .code-gen {
    display: inline-flex;
  }

  .code-lines {
    margin: 0;
    padding: 10px 14px 12px 0;
    list-style: none;
    counter-reset: line;
    color: #c9d6e6;
    font-size: 11.5px;
    line-height: 1.7;
  }

  .code-lines li {
    min-height: 1.7em;
    white-space: pre;
    counter-increment: line;
  }

  .code-lines li::before {
    content: counter(line);
    display: inline-block;
    width: 30px;
    margin-right: 10px;
    color: #475a7a;
    text-align: right;
  }

  .code-lines li.is-current::after {
    content: "";
    display: inline-block;
    width: 7px;
    height: 13px;
    margin-left: 1px;
    background: #a99cff;
    vertical-align: -2px;
  }

  .code-lines :global(.kw) { color: #c4b5ff; }
  .code-lines :global(.str) { color: #7ee0c3; }
  .code-lines :global(.attr) { color: #8fc3ff; }
  .code-lines :global(.ref) { color: #f5c98b; }

  /* ---------- checks + result ---------- */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
  }

  .checks {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    --tone: var(--violet);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background: #fff;
    border: 1px solid #dbe3ee;
    border-radius: 999px;
    color: #8494a8;
    font-size: 11px;
    transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }

  .checks li[data-state="active"] {
    border-color: #cbc4ff;
    color: var(--violet);
  }

  .checks li[data-state="active"] .spin {
    display: inline-block;
  }

  .checks li[data-state="done"] {
    --tone: var(--teal);
    background: #ecf8f3;
    border-color: #bfe5d6;
    color: #12805f;
  }

  .checks li[data-state="done"] .tick {
    display: inline-grid;
    width: 13px;
    height: 13px;
    font-size: 8px;
  }

  .deployed {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 13px 6px 6px;
    background: linear-gradient(135deg, #10a37f, #0e8a9c);
    border-radius: 999px;
    color: #fff;
    font: 600 13px/1 var(--font);
    box-shadow: 0 10px 20px -12px rgba(16, 163, 127, 0.9);
  }

  .deployed b {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    font-size: 11px;
  }

  .deployed[data-state="idle"] {
    opacity: 0;
    transform: scale(0.9);
  }

  .deployed[data-state="done"] {
    animation: pop 0.45s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  @keyframes beam {
    from { stroke-dashoffset: 0.5; }
    to { stroke-dashoffset: -1; }
  }

  @keyframes fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes pop {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: none; }
  }

  @keyframes blink {
    to { opacity: 0; }
  }

  @media (max-width: 520px) {
    .code-lines { font-size: 10px; }
    .code-lines li::before { width: 20px; margin-right: 8px; }
    .checks li { padding: 4px 8px; }
  }
</style>
