---
// "A typical setup" illustration in the style of a cloud project canvas:
// flat service cards on a dot grid, joined by thin connectors. Requests glide along the
// connectors, status dots pulse, one pod periodically redeploys and the monitoring
// sparkline scrolls. Everything scales with the canvas width (container query units),
// pauses off-screen and stays still with reduced motion.
import toolIcons from "../data/tools.json";

const logo = (name: string) => toolIcons.find((tool) => tool.name === name);
const cloudPath = "M6.5 19a5 5 0 0 1-.9-9.92A6.5 6.5 0 0 1 18.3 8.6 5.25 5.25 0 0 1 17.75 19Z";

// Layout in a 480 × 400 design space (cards are 150 wide).
const W = 480;
const H = 400;
const cards = [
  { id: "lb", x: 165, y: 30, name: "gateway", meta: "HTTPS", icon: { path: cloudPath, color: "#FF9900" } },
  { id: "api1", x: 40, y: 150, name: "api", meta: "pod 1", icon: logo("Kubernetes") },
  { id: "api2", x: 290, y: 150, name: "api", meta: "pod 2", icon: logo("Kubernetes") },
  { id: "db", x: 120, y: 290, name: "postgres", meta: "primary", icon: logo("PostgreSQL") },
];

// Connectors run from the bottom-centre of one card to the top-centre of the next.
const links = [
  { id: "lb-api1", d: "M240 92 C240 124 115 118 115 150" },
  { id: "lb-api2", d: "M240 92 C240 124 365 118 365 150" },
  { id: "api1-db", d: "M115 212 C115 252 195 250 195 290" },
  { id: "api2-db", d: "M365 212 C365 254 195 248 195 290" },
];

// Request pulses: which connector, and when within the shared cycle (0..1).
const pulses = [
  { link: "lb-api1", at: 0 },
  { link: "api1-db", at: 0.2 },
  { link: "lb-api2", at: 0.5 },
  { link: "api2-db", at: 0.7 },
];

const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;
const grafana = logo("Grafana");
---

<div class="canvas" data-canvas>
  <div class="stage">
    <svg class="wires" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <defs>
        {links.map((link) => <path id={`wire-${link.id}`} d={link.d} />)}
      </defs>
      {links.map((link) => (
        <use href={`#wire-${link.id}`} class="wire" />
      ))}
      <path class="wire wire-metrics" d="M372 212 L372 290" />
      {pulses.map((pulse) => (
        <path d={links.find((link) => link.id === pulse.link)?.d} class="pulse" pathLength="1" style={`--at: ${pulse.at}`} />
      ))}
    </svg>

    {cards.map((card, i) => (
      <div
        class="card"
        data-card={card.id}
        data-state="online"
        style={`left: ${pct(card.x, W)}; top: ${pct(card.y, H)}; --i: ${i}`}
      >
        <span class="logo" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d={card.icon?.path} fill={card.icon?.color} /></svg>
        </span>
        <span class="text">
          <strong>{card.name}</strong>
          <span class="status">
            <i class="spin"></i><span data-status>Online</span><em>· {card.meta}</em>
          </span>
        </span>
      </div>
    ))}

    <div class="card card-metrics" style={`left: ${pct(300, W)}; top: ${pct(290, H)}; --i: 4`}>
      <span class="logo" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d={grafana?.path} fill={grafana?.color} /></svg>
      </span>
      <span class="text">
        <strong>grafana</strong>
        <svg class="spark" viewBox="0 0 90 18" preserveAspectRatio="none" aria-hidden="true">
          <g class="spark-scroll">
            <path d="M0 13 L9 10 L18 12 L27 7 L36 9 L45 5 L54 8 L63 6 L72 10 L81 8 L90 13 L99 10 L108 12 L117 7 L126 9 L135 5 L144 8 L153 6 L162 10 L171 8 L180 13" />
          </g>
        </svg>
      </span>
    </div>

    <span class="env">staging · eu-west-1</span>
  </div>
</div>

<script>
  // Every few seconds pod 2 redeploys: Deploying (spinner) → Online. Also pauses
  // CSS animations while the canvas is off-screen.
  document.querySelectorAll<HTMLElement>("[data-canvas]").forEach((canvas) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      canvas.classList.add("is-in");
      return;
    }

    const pod = canvas.querySelector<HTMLElement>('[data-card="api2"]')!;
    const label = pod.querySelector<HTMLElement>("[data-status]")!;
    let timer = 0;

    const deploy = () => {
      pod.dataset.state = "deploying";
      label.textContent = "Deploying";
      timer = window.setTimeout(() => {
        pod.dataset.state = "online";
        label.textContent = "Online";
        timer = window.setTimeout(deploy, 7000);
      }, 2600);
    };

    new IntersectionObserver(([entry]) => {
      canvas.classList.toggle("is-paused", !entry.isIntersecting);
      if (entry.isIntersecting) {
        if (!canvas.classList.contains("is-in")) {
          canvas.classList.add("is-in");
          timer = window.setTimeout(deploy, 5200);
        }
      }
    }, { threshold: 0.35 }).observe(canvas);

    window.addEventListener("pagehide", () => clearTimeout(timer));
  });
</script>

<style>
  .canvas {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding: 4%;
    background:
      radial-gradient(circle at 1px 1px, #d7dde7 1px, transparent 0) 0 0 / 16px 16px,
      #f7f9fc;
    border: 1px solid #e3e8ef;
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    container-type: inline-size;
  }

  /* All sizes below are in em, and 1em scales with the canvas width. */
  .stage {
    position: relative;
    aspect-ratio: 480 / 400;
    font-size: 2.6cqw;
    font-family: var(--font);
  }

  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .wire {
    fill: none;
    stroke: #c9d1dd;
    stroke-width: 1.5;
  }

  .wire-metrics {
    stroke-dasharray: 3 4;
  }

  /* A soft light that glides along a connector. */
  .pulse {
    fill: none;
    stroke: #6366f1;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0.14 2;
    stroke-dashoffset: 0.14;
    filter: drop-shadow(0 0 3px rgba(99, 102, 241, 0.8));
  }

  /* ---------- cards ---------- */
  .card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75em;
    /* 150 × 62 in the 480-wide design space */
    width: 12.02em;
    height: 4.97em;
    padding: 0 0.9em;
    background: #fff;
    border: 1px solid #e3e8ef;
    border-radius: 0.8em;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.05),
      0 0.8em 1.6em -1em rgba(15, 23, 42, 0.25);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .card:hover {
    border-color: #c7cede;
    transform: translateY(-2px);
  }

  .logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.3em;
    height: 2.3em;
    background: #fff;
    border: 1px solid #edf0f5;
    border-radius: 0.6em;
  }

  .logo svg {
    width: 1.3em;
    height: 1.3em;
  }

  .text {
    display: grid;
    gap: 0.2em;
    min-width: 0;
  }

  .text strong {
    overflow: hidden;
    color: #111827;
    font-size: 1em;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status em {
    color: #9ca3af;
    font-style: normal;
    font-weight: 400;
    white-space: nowrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: #15803d;
    font-size: 0.85em;
    font-weight: 500;
  }

  .spin {
    display: none;
    width: 0.75em;
    height: 0.75em;
    border: 1.5px solid #fde3b0;
    border-top-color: #d97706;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .card[data-state="deploying"] {
    border-color: #f6d79b;
    box-shadow:
      0 0 0 3px rgba(245, 158, 11, 0.12),
      0 0.8em 1.6em -1em rgba(15, 23, 42, 0.25);
  }

  .card[data-state="deploying"] .status {
    color: #b45309;
  }

  .card[data-state="deploying"] .spin {
    display: inline-block;
  }

  /* metrics card */
  .spark {
    width: 6.4em;
    height: 1.3em;
    overflow: hidden;
  }

  .spark path {
    fill: none;
    stroke: #f46800;
    stroke-width: 1.6;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .env {
    position: absolute;
    right: 0;
    top: 0;
    padding: 0.3em 0.7em;
    background: #fff;
    border: 1px solid #e3e8ef;
    border-radius: 999px;
    color: #6b7280;
    font: 0.78em var(--mono);
  }

  /* ---------- motion ---------- */
  :global(.js-anim) .canvas:not(:global(.is-in)) .card,
  :global(.js-anim) .canvas:not(:global(.is-in)) .env {
    opacity: 0;
  }

  :global(.js-anim) .canvas:not(:global(.is-in)) .wire {
    opacity: 0;
  }

  .canvas:global(.is-in) .card {
    animation: card-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 0.09s) both;
  }

  .canvas:global(.is-in) .wire {
    animation: fade-in 0.8s ease 0.45s both;
  }

  .canvas:global(.is-in) .env {
    animation: fade-in 0.6s ease 0.6s both;
  }

  .canvas:global(.is-in) .pulse {
    animation: glide 3.6s cubic-bezier(0.45, 0, 0.4, 1) calc(1.2s + 3.6s * var(--at)) infinite backwards;
  }

  .canvas:global(.is-in) .spark-scroll {
    animation: scroll 7s linear infinite;
  }

  .canvas:global(.is-paused) * {
    animation-play-state: paused !important;
  }

  @keyframes card-in {
    from { opacity: 0; transform: translateY(0.9em) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  @keyframes fade-in {
    from { opacity: 0; }
  }

  @keyframes glide {
    0% { stroke-dashoffset: 0.14; opacity: 1; }
    22% { stroke-dashoffset: -1; opacity: 1; }
    23%, 100% { stroke-dashoffset: -1; opacity: 0; }
  }

  @keyframes scroll {
    to { transform: translateX(-90px); }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
