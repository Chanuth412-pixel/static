---
// Illustrations shown in place of project screenshots until real media is added.
// Each one plays a short sequence once when scrolled into view (motion.ts adds .is-playing);
// the AI one is a looping deployment card (DeployCard), the platform one a pipeline run (PipelineRun).
interface Props {
  kind: "ai" | "platform" | "iot" | "identity" | "research" | "agri" | "web";
}

import DeployCard from "./DeployCard.astro";
import PipelineRun from "./PipelineRun.astro";

const { kind } = Astro.props;

---

<div class:list={["pv", `pv--${kind}`]} data-play aria-hidden="true">

  {kind === "ai" && <DeployCard />}

  {kind === "web" && (
    <div class="web">
      <div class="browser">
        <div class="browser-bar">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url">racoona.ai</span>
        </div>
        <div class="page">
          <div class="page-nav" data-step style="--d: 0s">
            <span class="logo">RACOONA.</span>
            <span class="nav-lines"><i></i><i></i><i></i></span>
          </div>
          <div class="page-hero">
            <span class="bar bar-xl" data-step style="--d: 0.25s"></span>
            <span class="bar bar-l" data-step style="--d: 0.4s"></span>
            <span class="bar bar-text" data-step style="--d: 0.55s"></span>
            <span class="btn" data-step style="--d: 0.7s"></span>
          </div>
          <div class="page-cards">
            <span data-step style="--d: 0.85s"></span>
            <span data-step style="--d: 0.95s"></span>
            <span data-step style="--d: 1.05s"></span>
          </div>
          <div class="form" data-step style="--d: 1.25s">
            <span class="field"></span>
            <span class="field"></span>
            <span class="send">Send</span>
          </div>
        </div>
      </div>
      <div class="toast" data-step style="--d: 2.1s">
        <span class="ok">✓</span>
        <span><strong>Message delivered</strong><small>Contact form → email</small></span>
      </div>
    </div>
  )}

  {kind === "platform" && <PipelineRun />}

  {kind !== "ai" && kind !== "web" && kind !== "platform" && (
    <div class="simple">
      <strong>{kind}</strong>
    </div>
  )}
</div>

<style>
  .pv {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 340px;
    padding: 34px 28px;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, #d6e2ef 1px, transparent 0) 0 0 / 18px 18px,
      linear-gradient(160deg, #f5f9fd, #eef4fa);
    font-family: var(--font);
  }

  .pv > div {
    width: 100%;
    max-width: 460px;
  }

  .tag {
    display: inline-block;
    color: #60758b;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tag-accent {
    color: var(--accent);
  }

  .ok {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sage);
    color: #fff;
    font-size: 11px;
  }

  /* Website */
  .web {
    position: relative;
    padding-bottom: 18px;
  }

  .browser {
    overflow: hidden;
    background: #fff;
    border: 1px solid #d3dfec;
    border-radius: 12px;
    box-shadow: 0 24px 40px -30px rgba(38, 56, 77, 0.6);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    background: #f3f7fb;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cfdbe8;
  }

  .url {
    flex: 1;
    max-width: 200px;
    padding: 3px 10px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: #60758b;
    font-size: 11px;
  }

  .page {
    display: grid;
    gap: 14px;
    padding: 16px 18px 18px;
  }

  .page-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    color: var(--accent);
    font: 800 13px/1 "Inter Variable", Inter, sans-serif;
    letter-spacing: 0.04em;
  }

  .nav-lines {
    display: flex;
    gap: 8px;
  }

  .nav-lines i,
  .bar,
  .field {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: #dbe5f0;
  }

  .nav-lines i {
    width: 26px;
  }

  .page-hero {
    display: grid;
    gap: 7px;
  }

  .bar-xl { width: 78%; height: 12px; background: #26384d; }
  .bar-l { width: 56%; height: 12px; background: #26384d; }
  .bar-text { width: 64%; margin-top: 4px; }

  .btn {
    width: 72px;
    height: 20px;
    margin-top: 6px;
    border-radius: 5px;
    background: var(--accent);
  }

  .page-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .page-cards span {
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #f7fafd;
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 10px;
    border: 1px dashed #c6d6e7;
    border-radius: 8px;
  }

  .field {
    height: 18px;
    background: #f1f5fa;
    border: 1px solid var(--line);
  }

  .send {
    padding: 3px 10px;
    border-radius: 5px;
    background: #26384d;
    color: #fff;
    font-size: 10.5px;
  }

  .toast {
    position: absolute;
    right: -6px;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    background: #fff;
    border: 1px solid #c9dfd0;
    border-radius: 10px;
    box-shadow: 0 16px 30px -18px rgba(38, 56, 77, 0.55);
  }

  .toast strong {
    display: block;
    color: var(--ink);
    font: 600 13px/1.2 "Inter Variable", Inter, sans-serif;
  }

  .toast small {
    color: #60758b;
    font-size: 10.5px;
  }

  .simple {
    color: #60758b;
    text-align: center;
    text-transform: capitalize;
  }

  /* Motion: hidden only when JS enables animation; each visual plays once. */
  :global(.js-anim) .pv [data-step] {
    opacity: 0;
  }

  .pv:global(.is-playing) [data-step] {
    animation: pv-rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }

  .pv:global(.is-playing) .toast {
    animation: pv-pop 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) var(--d, 0s) both;
  }

  @keyframes pv-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes pv-pop {
    from { opacity: 0; transform: scale(0.9) translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 520px) {
    .pv { padding: 18px; }
    .toast { right: 0; }
  }
</style>
