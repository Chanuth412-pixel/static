---
// Project illustration: one run of the multi-agent infrastructure generator, shown the way
// tracing tools show agent runs (a span tree with a timing waterfall and an output panel).
// It replays on a loop while on screen. The HTML is the finished run, so without JS or with
// reduced motion it shows a complete trace.

type Span = { name: string; type: "chain" | "llm" | "retriever" | "tool"; depth: number; start: number; end: number };

const TOTAL = 9; // seconds on the timeline
const spans: Span[] = [
  { name: "infra_agent", type: "chain", depth: 0, start: 0, end: 8.7 },
  { name: "orchestrator.plan", type: "llm", depth: 1, start: 0.2, end: 1.4 },
  { name: "rag.retrieve_context", type: "retriever", depth: 1, start: 1.5, end: 2.6 },
  { name: "llm.generate_terraform", type: "llm", depth: 1, start: 1.5, end: 4.3 },
  { name: "terraform validate", type: "tool", depth: 1, start: 4.4, end: 5.0 },
  { name: "terraform plan", type: "tool", depth: 1, start: 5.1, end: 6.0 },
  { name: "terraform apply", type: "tool", depth: 1, start: 6.1, end: 8.6 },
];

const pct = (seconds: number) => `${((seconds / TOTAL) * 100).toFixed(2)}%`;
const fmt = (seconds: number) => `${seconds.toFixed(1)}s`;
const ticks = [0, 2, 4, 6, 8];
---

<div class="trace" data-trace data-total={TOTAL}>
  <!-- window bar -->
  <div class="bar-top">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="run-name">infra_agent <em>· staging-api</em></span>
    <span class="run-state" data-run-state="done">
      <i class="pulse"></i><span data-run-label>Succeeded</span>
    </span>
    <span class="run-time" data-run-time>{fmt(spans[0].end)}</span>
  </div>

  <!-- input -->
  <div class="input">
    <span class="k">input</span>
    <span class="v">"Staging environment for the API"</span>
  </div>

  <!-- span tree + waterfall -->
  <div class="waterfall">
    <div class="axis" aria-hidden="true">
      <span class="axis-name">Span</span>
      <span class="axis-lane">
        {ticks.map((t) => <i style={`left: ${pct(t)}`}>{t}s</i>)}
      </span>
    </div>

    <ol class="spans">
      {spans.map((span) => (
        <li
          class:list={["span", `type-${span.type}`, span.end / TOTAL > 0.85 && "label-in"]}
          style={`--depth: ${span.depth}`}
          data-span
          data-start={span.start}
          data-end={span.end}
          data-state="done"
        >
          <span class="span-name">
            <i class="type" aria-hidden="true">
              {span.type === "chain" && <svg viewBox="0 0 16 16"><path d="M3 8h10M8 3v10" /></svg>}
              {span.type === "llm" && <svg viewBox="0 0 16 16"><path d="M8 2.5 9.4 6.6 13.5 8 9.4 9.4 8 13.5 6.6 9.4 2.5 8 6.6 6.6Z" /></svg>}
              {span.type === "retriever" && <svg viewBox="0 0 16 16"><ellipse cx="8" cy="4.5" rx="4.5" ry="2" /><path d="M3.5 4.5v7c0 1.1 2 2 4.5 2s4.5-.9 4.5-2v-7M3.5 8c0 1.1 2 2 4.5 2s4.5-.9 4.5-2" /></svg>}
              {span.type === "tool" && <svg viewBox="0 0 16 16"><path d="m4 5 3 3-3 3M8.5 11.5h4" /></svg>}
            </i>
            <span class="span-label">{span.name}</span>
          </span>
          <span class="lane">
            <span class="span-bar" style={`left: ${pct(span.start)}; width: ${pct(span.end - span.start)}`}>
              <em data-dur>{fmt(span.end - span.start)}</em>
            </span>
          </span>
        </li>
      ))}
    </ol>

    <span class="playhead" data-playhead aria-hidden="true"></span>
  </div>

  <!-- output of the latest step -->
  <div class="output">
    <div class="output-head">
      <span class="output-tab">Output</span>
      <span class="output-span" data-output-span>terraform apply</span>
    </div>
    <pre class="output-body" data-output><span class="ok">aws_vpc.main: Creation complete</span>
<span class="ok">aws_subnet.private: Creation complete</span>
<span class="ok">aws_instance.api: Creation complete</span>
<b>Apply complete! Resources: 3 added, 0 changed, 0 destroyed.</b></pre>
  </div>
</div>

<script>
  const esc = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;");

  // Terraform the LLM step "writes", highlighted per token.
  const code: [string, string][][] = [
    [["kw", "resource"], ["", " "], ["str", '"aws_instance"'], ["", " "], ["str", '"api"'], ["", " {"]],
    [["", "  "], ["attr", "ami"], ["", "           = "], ["ref", "data.aws_ami.ubuntu.id"]],
    [["", "  "], ["attr", "instance_type"], ["", " = "], ["ref", "var.size"]],
    [["", "  "], ["attr", "subnet_id"], ["", "     = "], ["ref", "aws_subnet.private.id"]],
    [["", "}"]],
  ];
  const codeLength = code.flat().reduce((sum, [, text]) => sum + text.length + 0, 0) + code.length;

  const renderCode = (chars: number) => {
    let left = chars;
    const lines: string[] = [];
    for (const line of code) {
      if (left <= 0) break;
      let out = "";
      for (const [kind, text] of line) {
        if (left <= 0) break;
        const part = esc(text.slice(0, left));
        left -= text.length;
        out += kind ? `<span class="${kind}">${part}</span>` : part;
      }
      left -= 1; // newline
      lines.push(out);
    }
    return lines.join("\n") + (chars < codeLength ? '<i class="caret"></i>' : "");
  };

  // What the output panel shows while (and after) each span runs. p = progress 0..1.
  const outputs: Record<string, (p: number) => string> = {
    "orchestrator.plan": (p) =>
      ['<span class="dim">plan:</span>', "1. retrieve project context", "2. generate terraform for an api server", "3. validate, plan, apply"]
        .slice(0, 1 + Math.ceil(p * 3))
        .join("\n"),
    "rag.retrieve_context": (p) =>
      [
        '<span class="dim">4 documents</span>',
        "network.md      <span class=\"dim\">score 0.91</span>",
        "api-service.md  <span class=\"dim\">score 0.88</span>",
        "conventions.md  <span class=\"dim\">score 0.83</span>",
      ]
        .slice(0, 1 + Math.ceil(p * 3))
        .join("\n"),
    "llm.generate_terraform": (p) => renderCode(Math.floor(p * codeLength)),
    "terraform validate": (p) => (p < 1 ? '<span class="dim">validating…</span>' : '<span class="ok">Success! The configuration is valid.</span>'),
    "terraform plan": (p) =>
      p < 1
        ? '<span class="dim">refreshing state…</span>'
        : '<span class="add">+ aws_vpc.main</span>\n<span class="add">+ aws_subnet.private</span>\n<span class="add">+ aws_instance.api</span>\n<b>Plan: 3 to add, 0 to change, 0 to destroy.</b>',
    "terraform apply": (p) =>
      [
        '<span class="ok">aws_vpc.main: Creation complete</span>',
        '<span class="ok">aws_subnet.private: Creation complete</span>',
        '<span class="ok">aws_instance.api: Creation complete</span>',
        "<b>Apply complete! Resources: 3 added, 0 changed, 0 destroyed.</b>",
      ]
        .slice(0, Math.max(1, Math.ceil(p * 4)))
        .join("\n"),
  };

  document.querySelectorAll<HTMLElement>("[data-trace]").forEach((root) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const total = Number(root.dataset.total);
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-span]")).map((row) => ({
      row,
      name: row.querySelector(".span-label")!.textContent ?? "",
      start: Number(row.dataset.start),
      end: Number(row.dataset.end),
      bar: row.querySelector<HTMLElement>(".span-bar")!,
      dur: row.querySelector<HTMLElement>("[data-dur]")!,
    }));
    const playhead = root.querySelector<HTMLElement>("[data-playhead]")!;
    const runState = root.querySelector<HTMLElement>("[data-run-state]")!;
    const runLabel = root.querySelector<HTMLElement>("[data-run-label]")!;
    const runTime = root.querySelector<HTMLElement>("[data-run-time]")!;
    const output = root.querySelector<HTMLElement>("[data-output]")!;
    const outputSpan = root.querySelector<HTMLElement>("[data-output-span]")!;

    const RUN = total * 1000; // 1 timeline second = 1 real second
    const HOLD = 3200;
    const end = Math.max(...rows.map((r) => r.end));

    let frame = 0;
    let begin = 0;
    let lastOutput = "";
    let active = false;

    const render = (t: number) => {
      const clock = Math.min(t, end);
      playhead.style.setProperty("--p", String(Math.min(t, total) / total));
      root.classList.toggle("is-running", t < end);

      for (const r of rows) {
        const state = t < r.start ? "queued" : t < r.end ? "running" : "done";
        if (r.row.dataset.state !== state) r.row.dataset.state = state;
        const shown = Math.max(0, Math.min(t, r.end) - r.start);
        r.bar.style.width = `${(shown / total) * 100}%`;
        r.dur.textContent = `${shown.toFixed(1)}s`;
      }

      // Output panel follows the most recent step that has started (skipping the root).
      const current = rows.filter((r) => r.name in outputs && t >= r.start).sort((a, b) => b.start - a.start || b.end - a.end)[0];
      let html = '<span class="dim">waiting for first step…</span>';
      let label = "—";
      if (current) {
        // Parallel steps: prefer the one still running.
        const running = rows.filter((r) => r.name in outputs && t >= r.start && t < r.end);
        const pick = running.length ? running[running.length - 1] : current;
        const p = Math.min(1, (t - pick.start) / (pick.end - pick.start));
        html = outputs[pick.name](p);
        label = pick.name;
      }
      if (html !== lastOutput) {
        output.innerHTML = html;
        lastOutput = html;
      }
      if (outputSpan.textContent !== label) outputSpan.textContent = label;

      runState.dataset.runState = t < end ? "running" : "done";
      runLabel.textContent = t < end ? "Running" : "Succeeded";
      runTime.textContent = `${clock.toFixed(1)}s`;
    };

    const loop = (now: number) => {
      if (!begin) begin = now;
      const elapsed = now - begin;
      if (elapsed > RUN + HOLD) begin = now;
      render(Math.min(elapsed, RUN) / 1000);
      if (active) frame = requestAnimationFrame(loop);
    };

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !active) {
        active = true;
        begin = 0;
        frame = requestAnimationFrame(loop);
      } else if (!entry.isIntersecting && active) {
        active = false;
        cancelAnimationFrame(frame);
      }
    }, { threshold: 0.3 }).observe(root);
  });
</script>

<style>
  .trace {
    --name: 196px;
    --c-chain: #5b5bd6;
    --c-llm: #8b5cf6;
    --c-retriever: #0f9d84;
    --c-tool: #2f7cf6;
    width: 100%;
    max-width: 520px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.05),
      0 24px 48px -28px rgba(30, 41, 70, 0.45);
    color: #1f2a3d;
    font: 12px/1.45 var(--font);
  }

  /* window bar */
  .bar-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    background: #f8fafc;
    border-bottom: 1px solid #e8edf3;
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #dde3eb;
  }

  .run-name {
    font: 600 12px var(--mono);
  }

  .run-name em {
    color: #8794a8;
    font-style: normal;
    font-weight: 400;
  }

  .run-state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 2px 9px 2px 7px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }

  .run-state .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .run-state[data-run-state="done"] {
    background: #e7f6ef;
    color: #13795b;
  }

  .run-state[data-run-state="running"] {
    background: #eef0ff;
    color: #4f46e5;
  }

  .run-state[data-run-state="running"] .pulse {
    animation: pulse 1s ease-in-out infinite;
  }

  .run-time {
    min-width: 34px;
    color: #64748b;
    font: 500 11px var(--mono);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* input */
  .input {
    display: flex;
    gap: 10px;
    padding: 8px 12px;
    border-bottom: 1px solid #eef2f6;
    font: 11.5px var(--mono);
  }

  .input .k { color: #8794a8; }
  .input .v { color: #1f2a3d; }

  /* waterfall */
  .waterfall {
    position: relative;
    padding: 4px 0 6px;
  }

  .axis,
  .span {
    display: grid;
    grid-template-columns: var(--name) 1fr;
    align-items: center;
    padding: 0 14px 0 12px;
  }

  .axis {
    height: 22px;
    color: #9aa5b5;
    font: 10px var(--mono);
  }

  .axis-lane {
    position: relative;
    height: 100%;
  }

  .axis-lane i {
    position: absolute;
    top: 5px;
    font-style: normal;
    transform: translateX(-50%);
  }

  .axis-lane i:first-child {
    transform: none;
  }

  .spans {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .span {
    height: 27px;
    transition: opacity 0.25s ease, background 0.25s ease;
  }

  .span[data-state="queued"] {
    opacity: 0.32;
  }

  .span[data-state="running"] {
    background: linear-gradient(90deg, rgba(99, 102, 241, 0.06), transparent 60%);
  }

  .span-name {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    padding-left: calc(var(--depth) * 14px);
    font: 11.5px var(--mono);
  }

  .span-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .type {
    display: grid;
    flex: none;
    place-items: center;
    width: 17px;
    height: 17px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--c) 14%, white);
    color: var(--c);
  }

  .type svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .type-chain { --c: var(--c-chain); }
  .type-llm { --c: var(--c-llm); }
  .type-retriever { --c: var(--c-retriever); }
  .type-tool { --c: var(--c-tool); }

  .lane {
    position: relative;
    height: 100%;
    background: repeating-linear-gradient(90deg, transparent 0 calc(22.22% - 1px), #f1f4f8 calc(22.22% - 1px) 22.22%);
  }

  .span-bar {
    position: absolute;
    top: 7px;
    height: 13px;
    border-radius: 4px;
    background: var(--c);
  }

  .span[data-state="running"] .span-bar {
    background:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent) 0 0 / 40px 100% no-repeat,
      var(--c);
    animation: shimmer 0.9s linear infinite;
  }

  .type-chain .span-bar {
    background: color-mix(in srgb, var(--c) 22%, white);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 40%, white);
  }

  .span-bar em {
    position: absolute;
    top: -1px;
    left: calc(100% + 6px);
    color: #64748b;
    font: 10px var(--mono);
    font-style: normal;
    white-space: nowrap;
  }

  .type-chain .span-bar em,
  .label-in .span-bar em {
    left: auto;
    right: 6px;
    color: var(--c);
  }

  .label-in:not(.type-chain) .span-bar em {
    color: #fff;
  }

  .span[data-state="queued"] .span-bar em {
    visibility: hidden;
  }

  /* playhead sweeps across the timeline column */
  .playhead {
    --p: 1;
    position: absolute;
    top: 4px;
    bottom: 6px;
    left: calc(12px + var(--name) + (100% - 26px - var(--name)) * var(--p));
    width: 1px;
    background: #6366f1;
    opacity: 0;
  }

  .playhead::before {
    content: "";
    position: absolute;
    top: 0;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6366f1;
  }

  .trace:global(.is-running) .playhead {
    opacity: 0.7;
  }

  /* output */
  .output {
    border-top: 1px solid #e8edf3;
    background: #0f172a;
  }

  .output-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    border-bottom: 1px solid #1e293b;
    font: 11px var(--mono);
  }

  .output-tab {
    padding: 7px 0 6px;
    border-bottom: 2px solid #818cf8;
    color: #e2e8f0;
  }

  .output-span {
    margin-left: auto;
    color: #7c8aa5;
  }

  .output-body {
    height: 104px;
    margin: 0;
    padding: 10px 14px;
    overflow: hidden;
    color: #cbd5e1;
    font: 11px/1.65 var(--mono);
    white-space: pre;
  }

  .output-body :global(.dim) { color: #7c8aa5; }
  .output-body :global(.ok) { color: #6ee7b7; }
  .output-body :global(.add) { color: #86efac; }
  .output-body :global(b) { color: #f8fafc; font-weight: 600; }
  .output-body :global(.kw) { color: #c4b5fd; }
  .output-body :global(.str) { color: #6ee7b7; }
  .output-body :global(.attr) { color: #93c5fd; }
  .output-body :global(.ref) { color: #fcd34d; }

  .output-body :global(.caret) {
    display: inline-block;
    width: 6px;
    height: 12px;
    margin-left: 1px;
    background: #a5b4fc;
    vertical-align: -2px;
  }

  @keyframes shimmer {
    from { background-position: -40px 0, 0 0; }
    to { background-position: calc(100% + 40px) 0, 0 0; }
  }

  @keyframes pulse {
    50% { opacity: 0.35; }
  }

  @media (max-width: 520px) {
    .trace { --name: 140px; }
    .span-name, .input { font-size: 10px; }
    .run-name em { display: none; }
    .output-body { font-size: 9.5px; height: 112px; white-space: pre-wrap; }
  }
</style>
