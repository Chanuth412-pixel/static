---
// Project illustration: a single deployment card. The request comes in, four steps tick
// off one by one, and the status turns to Ready. Loops while on screen.
// The HTML is the finished state, so without JS or with reduced motion it reads as complete.
const steps = [
  { label: "Generated Terraform", detail: "LLM + RAG agents", time: 2.8 },
  { label: "Validated", detail: "terraform validate", time: 0.6 },
  { label: "Planned", detail: "3 to add", time: 0.9 },
  { label: "Deployed to AWS", detail: "terraform apply", time: 2.5 },
];
const total = steps.reduce((sum, step) => sum + step.time, 0);
---

<div class="deploy" data-deploy>
  <span class="progress" data-progress aria-hidden="true"></span>
  <div class="head">
    <span class="mark" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 9.5 4.25 4.25 0 0 0 7 18Z" /></svg>
    </span>
    <span class="title">
      <strong>staging-api</strong>
      <small>“Staging environment for the API”</small>
    </span>
    <span class="elapsed" data-elapsed>{total.toFixed(1)}s</span>
    <span class="state" data-state="ready" data-status>
      <span data-status-label>Ready</span>
    </span>
  </div>

  <ol class="steps">
    {steps.map((step) => (
      <li data-step data-state="done" data-time={step.time}>
        <span class="icon" aria-hidden="true">
          <svg class="check" viewBox="0 0 16 16"><path d="m4 8.5 2.5 2.5L12 5.5" /></svg>
        </span>
        <span class="label">{step.label}<small>{step.detail}</small></span>
        <span class="time" data-time-label>{step.time.toFixed(1)}s</span>
      </li>
    ))}
  </ol>

  <div class="foot">
    <span class="domain">api.staging · eu-west-1</span>
    <span class="visit">Visit <span aria-hidden="true">↗</span></span>
  </div>
</div>

<script>
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.querySelectorAll<HTMLElement>("[data-deploy]").forEach((root) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.classList.add("is-in");
      return;
    }

    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-step]")).map((row) => ({
      row,
      time: Number(row.dataset.time),
      label: row.querySelector<HTMLElement>("[data-time-label]")!,
    }));
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const statusLabel = root.querySelector<HTMLElement>("[data-status-label]")!;
    const elapsed = root.querySelector<HTMLElement>("[data-elapsed]")!;
    const progress = root.querySelector<HTMLElement>("[data-progress]")!;
    const total = steps.reduce((sum, step) => sum + step.time, 0);
    const SPEED = 0.48; // real seconds per shown second
    let run = 0;

    const setStatus = (state: "building" | "ready") => {
      status.dataset.state = state;
      statusLabel.textContent = state === "ready" ? "Ready" : "Building";
    };

    // One step: its timer, the header timer and the top bar all advance together.
    const play = (index: number, live: () => boolean) =>
      new Promise<void>((resolve) => {
        const step = steps[index];
        const before = steps.slice(0, index).reduce((sum, s) => sum + s.time, 0);
        const duration = step.time * SPEED * 1000;
        const start = performance.now();
        const tick = (now: number) => {
          if (!live()) return resolve();
          const p = Math.min(1, (now - start) / duration);
          const shown = before + step.time * p;
          step.label.textContent = `${(step.time * p).toFixed(1)}s`;
          elapsed.textContent = `${shown.toFixed(1)}s`;
          progress.style.transform = `scaleX(${shown / total})`;
          if (p < 1) requestAnimationFrame(tick);
          else resolve();
        };
        requestAnimationFrame(tick);
      });

    const cycle = async (id: number) => {
      const live = () => id === run;
      root.classList.add("is-building");
      setStatus("building");
      elapsed.textContent = "0.0s";
      progress.style.transform = "scaleX(0)";
      steps.forEach((step) => {
        step.row.dataset.state = "idle";
        step.label.textContent = "0.0s";
      });
      await sleep(600);

      for (const [index, step] of steps.entries()) {
        if (!live()) return;
        step.row.dataset.state = "active";
        await play(index, live);
        if (!live()) return;
        step.row.dataset.state = "done";
        await sleep(160);
      }

      setStatus("ready");
      root.classList.remove("is-building");
      await sleep(3800);
      if (live()) cycle(id);
    };

    new IntersectionObserver(([entry]) => {
      run += 1;
      if (entry.isIntersecting) {
        root.classList.add("is-in");
        cycle(run);
      }
    }, { threshold: 0.4 }).observe(root);
  });
</script>

<style>
  .deploy {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 400px;
    transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 6px;
    background: #fff;
    border: 1px solid #e6e9ef;
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 24px 48px -30px rgba(15, 23, 42, 0.35);
    color: #111827;
    font-family: var(--font);
  }

  /* Entrance: rises in the first time it scrolls into view. */
  :global(.js-anim) .deploy:not(:global(.is-in)) {
    opacity: 0;
    transform: translateY(22px) scale(0.98);
  }

  /* Thin progress bar along the top edge while building. */
  .progress {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, #111827, #6366f1 70%, #22c55e);
    transform: scaleX(1);
    transform-origin: left;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .deploy:global(.is-building) .progress {
    opacity: 1;
  }

  .elapsed {
    margin-left: auto;
    color: #9ca3af;
    font: 12px var(--font);
    font-variant-numeric: tabular-nums;
  }

  /* header */
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 14px 16px;
  }

  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #111827;
    color: #fff;
  }

  .mark svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .title {
    display: grid;
    min-width: 0;
  }

  .title strong {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .title small {
    overflow: hidden;
    color: #6b7280;
    font-size: 12.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .state {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    position: relative;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .state[data-state="building"] {
    background: #fef6e7;
    color: #b45309;
  }

  .state[data-state="ready"] {
    background: #e9f8ef;
    color: #15803d;
  }

  /* "Ready" lands with a small pop and one pulse ring. */
  :global(.is-in) .state[data-state="ready"] {
    animation: pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  :global(.is-in) .state[data-state="ready"]::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.45);
    animation: ring 1.1s ease-out 0.1s;
  }

  /* steps */
  .steps {
    margin: 0;
    padding: 6px;
    list-style: none;
    background: #fafbfc;
    border: 1px solid #eef0f4;
    border-radius: 10px;
  }

  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 12px;
    overflow: hidden;
    padding: 10px 10px;
    border-radius: 8px;
    transition: opacity 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* The running step lifts out of the list with a light sweeping across it. */
  .steps li[data-state="active"] {
    background: #fff;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.06),
      0 6px 16px -10px rgba(15, 23, 42, 0.35);
    transform: translateX(3px);
  }

  .steps li[data-state="active"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(99, 102, 241, 0.09) 50%, transparent 70%) 0 0 / 220% 100%;
    animation: sweep 1.2s linear infinite;
  }

  .steps li[data-state="idle"] {
    opacity: 0.4;
  }

  .icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1.5px solid #d1d5db;
    border-radius: 50%;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  [data-state="active"] .icon {
    border-color: #e5e7eb;
    border-top-color: #111827;
    animation: spin 0.8s linear infinite;
  }

  [data-state="done"] .icon {
    background: #111827;
    border-color: #111827;
  }

  :global(.is-in) [data-state="done"] .icon {
    animation: pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .check {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
  }

  [data-state="done"] .check {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.3s ease 0.05s;
  }

  .label {
    display: grid;
    font-size: 14px;
    font-weight: 500;
  }

  .label small {
    color: #9ca3af;
    font: 11.5px var(--font);
  }

  .time {
    color: #9ca3af;
    font: 12px var(--font);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  [data-state="active"] .time,
  [data-state="done"] .time {
    opacity: 1;
  }

  [data-state="active"] .time {
    color: #4f46e5;
  }

  /* footer */
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 14px 10px;
    font-size: 13px;
  }

  .domain {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #374151;
    font-family: var(--font);
    font-size: 12px;
  }

  .visit {
    color: #111827;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  /* While a deployment is running, the domain isn't live yet. */
  .deploy:global(.is-building) .visit {
    color: #c0c5cd;
  }

  @keyframes pop {
    from { transform: scale(0.75); }
    to { transform: scale(1); }
  }

  @keyframes ring {
    to { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
  }

  @keyframes sweep {
    from { background-position: 120% 0; }
    to { background-position: -120% 0; }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
