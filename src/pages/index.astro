---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaFrame from "../components/MediaFrame.astro";
import ServiceCanvas from "../components/ServiceCanvas.astro";
import toolIcons from "../data/tools.json";
import linkIcons from "../data/link-icons.json";
import HeroRibbon from "../components/HeroRibbon.astro";

const base = import.meta.env.BASE_URL;

const featuredWork = [
  {
    title: "AI-Powered Infrastructure Generation",
    context: "Client work",
    problem: "Infrastructure requests needed to become reliable, context-aware deployments without repeating manual setup.",
    built: "A multi-agent system using LLMs and RAG to generate Terraform, deploy to AWS, validate the result and run post-deployment checks.",
    result: "A connected workflow from infrastructure request through validated AWS deployment.",
    visual: "ai",
    stack: ["Python", "LangGraph", "Ollama", "RAG", "AWS", "Terraform"],
    links: [
      { kind: "blog", label: "System overview", href: "https://dev.to/chanuth_412/agentic-pipeline-to-convert-aws-infrastructure-to-terraform-29k4" },
      { kind: "code", label: "Code", href: "https://github.com/Chanuth412-pixel/tf-agent/tree/main/tf%20agent" },
    ],
  },
  {
    title: "Racoona",
    context: "Client work · live site",
    problem: "The business needed a fast static website with a dependable way for visitors to make contact.",
    built: "Built and maintained the Astro site with contact forms and Web3Forms email delivery.",
    result: "A lightweight, live website with working contact delivery.",
    visual: "web",
    // Screenshot of the live homepage, shown in a browser frame. Replace the file to update it.
    image: "projects/racoona.webp",
    imageAlt: "Racoona AI homepage: “We Invest in Great Hospitality Businesses”",
    stack: ["Astro", "Web3Forms", "Email delivery"],
    href: "https://racoona.ai/",
    links: [
      { kind: "site", label: "Live site", href: "https://racoona.ai/" },
      { kind: "code", label: "Code", href: "https://github.com/Chanuth412-pixel/racoona/tree/main/racoona-web" },
    ],
  },
  {
    title: "Peracom Internal Developer Platform",
    context: "Platform engineering",
    problem: "Provisioning and deployment across infrastructure needed a repeatable path with observability.",
    built: "Automated provisioning and deployment with Proxmox, Terraform, Ansible and Kubernetes, with Prometheus and Grafana monitoring.",
    result: "A repeatable internal platform workflow with monitoring in place.",
    visual: "platform",
    stack: ["Proxmox", "Terraform", "Ansible", "Kubernetes", "Prometheus", "Grafana"],
    links: [
      { kind: "code", label: "Code", href: "https://github.com/IsharaEkanayaka/kubesmith" },
    ],
  },
];

const moreWork = [
  {
    title: "GloveXcel",
    description: "IoT rehabilitation glove with sensor processing, BLE communication and web APIs.",
    tags: ["ESP32", "BLE", "React", "Node.js"],
    links: [{ kind: "code", label: "Code", href: "https://github.com/cepdnaclk/e21-3yp-GloveXcel" }],
  },
  {
    title: "FreeIPA migration",
    description: "Moved legacy OpenLDAP to centralized FreeIPA on AlmaLinux 9 with Podman and Keycloak SSO.",
    tags: ["FreeIPA", "Keycloak", "Podman"],
    links: [
      { kind: "blog", label: "Overview", href: "https://dev.to/chanuth_412/running-freeipa-on-ubuntu-using-podman-mdo" },
      { kind: "blog", label: "Step-by-step guide", href: "https://dev.to/chanuth_412/running-freeipa-on-ubuntu-using-podman-part-2-step-by-step-deployment-3ngc" },
    ],
  },
  {
    title: "Agrimate",
    description: "Bilingual farmer-to-customer marketplace with crop-care advice and delivery routing.",
    tags: ["Flutter", "Node.js", "Firebase"],
    links: [
      { kind: "blog", label: "Blog post", href: "https://realworldsolutions-chan.blogspot.com/2025/10/making-marketplace-for-farmers-and.html" },
      { kind: "code", label: "Code", href: "https://github.com/Chanuth412-pixel/agrimate" },
    ],
  },
];

// Upwork stats for the credibility strip. Fill these in with the numbers shown on your
// Upwork profile (e.g. rating: "5.0", jobSuccess: "100%"); leave null to hide them.
const upwork = { rating: "5.0" as string | null, jobSuccess: "100%" as string | null };

// Profiles linked from the contact panel and footer.
const profiles = [
  { label: "GitHub", href: "https://github.com/Chanuth412-pixel" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/chanuth-abeynayake-459a95235" },
  { label: "Upwork", href: "https://www.upwork.com/freelancers/~019b9c84e4a834fb9e" },
];

// Icon for each link: GitHub for code, the blog's own mark for posts, an arrow for live sites.
const linkIcon = (href: string, kind: string) => {
  if (kind === "code") return linkIcons.github;
  if (href.includes("dev.to")) return linkIcons.devdotto;
  if (href.includes("blogspot")) return linkIcons.blogger;
  return null;
};

// Merged open-source pull requests, newest first. Stars as of Nov 2026.
const pullRequests = [
  { repo: "kubescape/kubescape", name: "Kubescape", stars: "12k", lang: "Go", number: 5233, title: "Report latest-version lookup failures in the installer" },
  { repo: "kubescape/kubescape", name: "Kubescape", stars: "12k", lang: "Go", number: 5177, title: "Correct the shell completion instructions" },
  { repo: "pypa/build", name: "PyPA build", stars: "865", lang: "Python", number: 1283, title: "Fix the troubleshooting hint when build isolation is disabled" },
  { repo: "terrakube-io/terrakube", name: "Terrakube", stars: "1k", lang: "Java", number: 3922, title: "Correctly remove a trailing .git from repository URLs" },
  { repo: "home-assistant/home-assistant.io", name: "Home Assistant docs", stars: "10.2k", lang: "HTML", number: 50530, title: "Fix broken FAQ links" },
  { repo: "terrakube-io/terrakube", name: "Terrakube", stars: "1k", lang: "Java", number: 3921, title: "Fix the telemetry Docker Compose instructions" },
  { repo: "pypa/build", name: "PyPA build", stars: "865", lang: "Python", number: 1282, title: "Update macOS runners in the CI documentation" },
  { repo: "pypa/build", name: "PyPA build", stars: "865", lang: "Python", number: 1281, title: "Fix the missing src directory in the tutorial" },
].map((pr) => ({ ...pr, href: `https://github.com/${pr.repo}/pull/${pr.number}` }));
const prProjects = [...new Set(pullRequests.map((pr) => pr.repo))];

// Each service: a short promise, the tools it uses (logos where one exists), and a timeline.
const services = [
  {
    title: "Cloud & DevOps setup",
    who: "A dependable path from infrastructure to production, defined in code and monitored from day one.",
    tools: ["Terraform", "AWS", "Kubernetes", "CI/CD", "Prometheus", "Grafana", "Keycloak SSO"],
    time: "2–6 weeks",
    icon: "cloud",
    tone: "cloud",
  },
  {
    title: "AI automation",
    who: "Useful AI wired into your real infrastructure, workflows and data, with checks so it stays reliable.",
    tools: ["LangGraph", "Ollama", "Python", "RAG", "LLM agents", "AWS"],
    time: "2–6 weeks",
    icon: "agent",
    tone: "ai",
  },
  {
    title: "Business websites",
    who: "A fast, clear site that loads instantly, works on every screen and turns visits into enquiries.",
    tools: ["Astro", "Node.js", "Responsive UI", "Contact forms", "Web3Forms"],
    time: "1–3 weeks",
    icon: "web",
    tone: "web",
  },
];

const processSteps = [
  { title: "Intro call", text: "We agree on the goal, constraints and what done looks like." },
  { title: "Proposal and fixed scope", text: "A written plan with deliverables, timeline and price." },
  { title: "Build with regular updates", text: "Short progress updates so you always know where things stand." },
  { title: "Handover and docs", text: "Working system, documentation and a walkthrough for your team." },
];
// Headline: one strong line, then a normal-size sub-line underneath.
const headlineLead = "Cloud infrastructure and AI automation for growing teams.";
const headlineSub = "Reliable deployments, less manual work, and systems your team can run.";
const headline = headlineLead.split(" ");

// Brand marks from simple-icons (CC0). AWS is not in that set, so it gets a plain cloud glyph.
const cloudPath = "M6.5 19a5 5 0 0 1-.9-9.92A6.5 6.5 0 0 1 18.3 8.6 5.25 5.25 0 0 1 17.75 19Z";
const tools = toolIcons.filter((tool) => tool.name !== "PostgreSQL").map((tool) => ({ ...tool, path: tool.path ?? cloudPath }));
const toolByName = new Map(tools.map((tool) => [tool.name, tool]));
---

<BaseLayout
  title="Chanuth Abeynayake — Freelance DevOps & AI automation engineer"
  description="Freelance DevOps and AI automation engineer building reliable cloud infrastructure, automation and fast business websites."
>
  <header class="site-header">
    <div class="site-shell header-inner">
      <a class="brand" href={`${base}#top`} aria-label="Chanuth Abeynayake home">CA<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#services">Services</a><a href="#work">Work</a><a href="#process">Process</a><a href="#contact">Contact</a>
      </nav>
      <a class="nav-cta" href="#contact">Get a quote <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <div class="site-shell">
    <main id="main">
      <section class="hero" id="top">
        <HeroRibbon />
        <div class="hero-copy">
          <p class="hero-kicker">Freelance cloud &amp; AI engineer · <span>taking new projects</span></p>
          <h1 aria-label={headlineLead}>{headline.map((word, index) => <><span class="w" style={`--w: ${index}`} aria-hidden="true">{word}</span>{" "}</>)}</h1>
          <p class="hero-description">{headlineSub}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contact">Get a quote <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="#work">See my work <span aria-hidden="true">↓</span></a>
          </div>
          <p class="trust-line">Code merged into <strong>Kubescape</strong>, <strong>Home Assistant</strong>, <strong>PyPA build</strong> and <strong>Terrakube</strong> · Client work for <strong>Racoona</strong></p>
        </div>
      </section>

      <section class="tools" aria-label="Tools I work with">
        <div class="marquee">
          <div class="marquee-track">
            {[...tools, ...tools].map((tool, index) => (
              <span class="tool" style={`--brand: ${tool.color}`} aria-hidden={index >= tools.length ? "true" : undefined}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={tool.path} /></svg>
                {tool.name}
              </span>
            ))}
          </div>
        </div>
      </section>

      <section class="credibility" aria-label="Credibility">
        <a href="#open-source">
          <span class="stat"><strong data-count={pullRequests.length}>{pullRequests.length}</strong></span>
          <span><b>merged open-source PRs</b>Across 4 projects · Kubescape · Home Assistant · PyPA · Terrakube</span>
          <i aria-hidden="true">↓</i>
        </a>
        <a href="#contact">
          <span class="stat"><strong data-count="24" data-suffix="h">24h</strong></span>
          <span><b>Reply time</b>Overlap with Europe and US mornings</span>
          <i aria-hidden="true">↓</i>
        </a>
        <a href={profiles[2].href} target="_blank" rel="noreferrer">
          {upwork.rating ? (
            <>
              <span class="stat"><strong>{upwork.rating}</strong><em aria-label="out of 5 stars">★</em></span>
              <span><b>Upwork rating</b>{upwork.jobSuccess ? `${upwork.jobSuccess} job success` : "2 client projects"}</span>
            </>
          ) : (
            <>
              <span class="stat"><strong data-count="2">2</strong></span>
              <span><b>client projects delivered</b>Reviews on Upwork</span>
            </>
          )}
          <i aria-hidden="true">↗</i>
        </a>
      </section>

      <section class="section stack reveal" id="setup">
        <div class="stack-copy">
          <p class="eyebrow">A typical setup</p>
          <h2>Built to run, not just to demo.</h2>
          <p>Most projects end up with the same backbone: infrastructure defined in code, traffic spread across containers, a managed database and monitoring from day one. You get the setup and the notes to run it yourself.</p>
          <ul class="stack-points">
            <li><strong>Terraform</strong> for repeatable environments</li>
            <li><strong>Kubernetes</strong> or containers behind a load balancer</li>
            <li><strong>Prometheus &amp; Grafana</strong> so problems show up early</li>
          </ul>
        </div>
        <ServiceCanvas />
      </section>

      <section class="section reveal" id="services">
        <div class="section-heading">
          <div><p class="eyebrow">Services</p><h2>Technical work that moves the business forward.</h2></div>
          <p>Choose a focused engagement or combine services around one outcome.</p>
        </div>
        <div class="service-grid" data-stagger>
          {services.map((service) => (
            <article class:list={["card", "service-card", `tone-${service.tone}`]} data-spotlight>
              <span class="service-icon" aria-hidden="true">
                {service.icon === "cloud" && (
                  <svg viewBox="0 0 24 24"><path d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 9.5 4.25 4.25 0 0 0 7 18Z" /></svg>
                )}
                {service.icon === "agent" && (
                  <svg viewBox="0 0 24 24"><rect x="5" y="8" width="14" height="11" rx="3" /><path d="M12 4v4M9 13h.01M15 13h.01M9.5 16h5" /></svg>
                )}
                {service.icon === "web" && (
                  <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18M7 7h.01M10 7h.01" /></svg>
                )}
              </span>
              <h3>{service.title}</h3>
              <p>{service.who}</p>
              <ul class="service-tools" aria-label={`Tools for ${service.title}`}>
                {service.tools.map((name) => {
                  const tool = toolByName.get(name);
                  return (
                    <li style={tool ? `--brand: ${tool.color}` : undefined}>
                      {tool && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={tool.path} /></svg>}
                      {name}
                    </li>
                  );
                })}
              </ul>
              <div class="service-foot">
                <span class="service-time"><span>Typical timeline</span>{service.time}</span>
                <a class="service-link" href="#contact">Get a quote <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section reveal" id="work">
        <div class="section-heading">
          <div><p class="eyebrow">Selected work</p><h2>Proof in the work.</h2></div>
          <p>Client delivery and platform engineering grounded in real systems.</p>
        </div>
        <div class="case-studies">
          {featuredWork.map((project, index) => (
            <article class:list={["case-study", index % 2 ? "case-study-reverse" : ""]}>
              {project.image ? (
                <MediaFrame
                  kind="image"
                  ratio="16/11"
                  src={`${base}${project.image}`}
                  alt={project.imageAlt ?? `${project.title} website`}
                  browser={project.href?.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                  href={project.href}
                />
              ) : (
                <MediaFrame kind="image" ratio="16/11" alt={`${project.title} system illustration`} visual={project.visual} />
              )}
              <div class="case-copy">
                <p class="card-label">{project.context}</p>
                <h3>{project.title}</h3>
                <dl>
                  <div><dt>Problem</dt><dd>{project.problem}</dd></div>
                  <div><dt>Built</dt><dd>{project.built}</dd></div>
                  <div><dt>Result</dt><dd>{project.result}</dd></div>
                </dl>
                <ul class="tag-list" aria-label={`Tools used for ${project.title}`}>
                  {project.stack.map((name) => {
                    const tool = toolByName.get(name);
                    return (
                      <li style={tool ? `--brand: ${tool.color}` : undefined}>
                        {tool && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={tool.path} /></svg>}
                        {name}
                      </li>
                    );
                  })}
                </ul>
                {project.links && (
                  <div class="project-links">
                    {project.links.map((link) => {
                      const icon = linkIcon(link.href, link.kind);
                      return (
                        <a class:list={["project-link", `project-link--${link.kind}`]} href={link.href} target="_blank" rel="noreferrer">
                          {icon && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon} /></svg>}
                          {link.label}
                          <span aria-hidden="true">↗</span>
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
        <div class="more-work">
          <h3>More projects</h3>
          <div class="more-grid" data-stagger>
            {moreWork.map((project) => (
              <article class="more-card" data-spotlight>
                <h4>{project.title}</h4>
                <p>{project.description}</p>
                <ul class="tag-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
                <div class="project-links">
                  {project.links.map((link) => {
                    const icon = linkIcon(link.href, link.kind);
                    return (
                      <a class:list={["project-link", `project-link--${link.kind}`]} href={link.href} target="_blank" rel="noreferrer">
                        {icon && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon} /></svg>}
                        {link.label}
                        <span aria-hidden="true">↗</span>
                      </a>
                    );
                  })}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section band reveal" id="open-source">
        <div class="section-heading">
          <div><p class="eyebrow">Open source</p><h2>Comfortable in other people's codebases.</h2></div>
          <p>{pullRequests.length} merged fixes across {prProjects.length} projects, from Kubescape (12k★) to Home Assistant, each reviewed against the project's own standards.</p>
        </div>
        <div class="pr-list" data-stagger>
          {pullRequests.map((pr) => (
            <a class="pr-row" data-spotlight href={pr.href} target="_blank" rel="noreferrer" aria-label={`${pr.title} — ${pr.repo} pull request #${pr.number}, merged`}>
              <span class="pr-repo">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={linkIcons.github} /></svg>
                <span>{pr.name}<small>★ {pr.stars} · {pr.lang}</small></span>
              </span>
              <span class="pr-main">
                <strong>{pr.title}</strong>
                <small>#{pr.number}</small>
              </span>
              <em>Merged</em>
              <span class="pr-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section reveal" id="process">
        <div class="section-heading">
          <div><p class="eyebrow">How a project runs</p><h2>A clear path from first conversation to handover.</h2></div>
        </div>
        <ol class="timeline" data-stagger>
          {processSteps.map((step, index) => (
            <li>
              <span class="timeline-dot">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <ul class="availability">
          <li>Response within 24 hours</li>
          <li>Based in Sri Lanka (UTC+5:30)</li>
          <li>Overlap with Europe and US mornings</li>
        </ul>
        <p class="education">
          Computer Engineering undergraduate at the University of Peradeniya.
          Team lead in three hackathon finals: SLASSCOM Xcelerate, SLIIT CodeFest and SLT CodeBlast
          (<a href={profiles[1].href} target="_blank" rel="noreferrer">LinkedIn ↗</a>).
        </p>
      </section>

      <section class="contact-panel reveal" id="contact">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Have a system to improve?</h2>
          <p>Tell me what you need, and I’ll reply with the next sensible step.</p>
          <a class="contact-email" href="mailto:chanuth412@gmail.com">chanuth412@gmail.com <span aria-hidden="true">↗</span></a>
          <div class="social-links">
            {profiles.map((profile) => <a href={profile.href} target="_blank" rel="noreferrer">{profile.label} ↗</a>)}
            <a href={`${base}cv.pdf`} download>CV ↓</a>
          </div>
        </div>
        <form class="contact-form" data-contact-form>
          <div class="form-row">
            <label>Name<input name="name" autocomplete="name" required /></label>
            <label>Email<input type="email" name="email" autocomplete="email" required /></label>
          </div>
          <label>What do you need?<textarea name="need" rows="4" required></textarea></label>
          <div class="form-row">
            <label>Budget range<select name="budget"><option value="">Select a range</option><option>To discuss</option><option>Under $1,000</option><option>$1,000–$3,000</option><option>$3,000+</option></select></label>
            <label>Timeline<select name="timeline"><option value="">Select a timeline</option><option>As soon as possible</option><option>Within 1 month</option><option>Flexible</option></select></label>
          </div>
          <button class="button button-light" type="submit">Send enquiry <span aria-hidden="true">→</span></button>
          <p class="form-status" role="status" data-form-status></p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href={`${base}#top`}>CA<span>.</span></a>
      <a href="mailto:chanuth412@gmail.com">chanuth412@gmail.com</a>
      {profiles.map((profile) => <a href={profile.href} target="_blank" rel="noreferrer">{profile.label}</a>)}
      <a href={`${base}cv.pdf`} download>CV</a>
      <small>© {new Date().getFullYear()} Chanuth Abeynayake</small>
    </footer>
  </div>
</BaseLayout>

<script>
  import { initPortfolioMotion } from "../scripts/motion";
  const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
  // TODO(chanuth): Add PUBLIC_WEB3FORMS_ACCESS_KEY to enable Web3Forms submissions.

  initPortfolioMotion();

  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-form-status]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    const data = new FormData(form);
    if (!accessKey) {
      const subject = encodeURIComponent("Project enquiry from portfolio");
      const body = encodeURIComponent(
        `Name: ${data.get("name")}\nEmail: ${data.get("email")}\nWhat I need: ${data.get("need")}\nBudget: ${data.get("budget")}\nTimeline: ${data.get("timeline")}`
      );
      window.location.href = `mailto:chanuth412@gmail.com?subject=${subject}&body=${body}`;
      status.textContent = "Opening your email client…";
      return;
    }

    data.append("access_key", accessKey);
    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      if (!response.ok) throw new Error("Web3Forms request failed");
      form.reset();
      status.textContent = "Thanks — your enquiry has been sent.";
    } catch (error) {
      console.error(error);
      status.textContent = "Something went wrong. Please email chanuth412@gmail.com directly.";
    }
  });
</script>
