---
// Project illustration: a single deployment card. The request comes in, four steps tick
// off one by one, and the status turns to Ready. Loops while on screen.
// The HTML is the finished state, so without JS or with reduced motion it reads as complete.
const steps = [
  { label: "Generated Terraform", detail: "LLM + RAG agents", time: "2.8s" },
  { label: "Validated", detail: "terraform validate", time: "0.6s" },
  { label: "Planned", detail: "3 to add", time: "0.9s" },
  { label: "Deployed to AWS", detail: "terraform apply", time: "2.5s" },
];
---

<div class="deploy" data-deploy>
  <div class="head">
    <span class="mark" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 9.5 4.25 4.25 0 0 0 7 18Z" /></svg>
    </span>
    <span class="title">
      <strong>staging-api</strong>
      <small>“Staging environment for the API”</small>
    </span>
    <span class="state" data-state="ready" data-status>
      <i></i><span data-status-label>Ready</span>
    </span>
  </div>

  <ol class="steps">
    {steps.map((step) => (
      <li data-step data-state="done">
        <span class="icon" aria-hidden="true">
          <svg class="check" viewBox="0 0 16 16"><path d="m4 8.5 2.5 2.5L12 5.5" /></svg>
        </span>
        <span class="label">{step.label}<small>{step.detail}</small></span>
        <span class="time">{step.time}</span>
      </li>
    ))}
  </ol>

  <div class="foot">
    <span class="domain"><i aria-hidden="true"></i>api.staging · eu-west-1</span>
    <span class="visit">Visit <span aria-hidden="true">↗</span></span>
  </div>
</div>

<script>
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.querySelectorAll<HTMLElement>("[data-deploy]").forEach((root) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const label = root.querySelector<HTMLElement>("[data-status-label]")!;
    const durations = [1300, 700, 800, 1300];
    let run = 0;

    const setStatus = (state: "building" | "ready") => {
      status.dataset.state = state;
      label.textContent = state === "ready" ? "Ready" : "Building";
    };

    const cycle = async (id: number) => {
      const live = () => id === run;
      root.classList.add("is-building");
      setStatus("building");
      steps.forEach((step) => (step.dataset.state = "idle"));
      await sleep(700);

      for (const [i, step] of steps.entries()) {
        if (!live()) return;
        step.dataset.state = "active";
        await sleep(durations[i]);
        if (!live()) return;
        step.dataset.state = "done";
        await sleep(150);
      }

      setStatus("ready");
      root.classList.remove("is-building");
      await sleep(3600);
      if (live()) cycle(id);
    };

    new IntersectionObserver(([entry]) => {
      run += 1;
      if (entry.isIntersecting) cycle(run);
    }, { threshold: 0.4 }).observe(root);
  });
</script>

<style>
  .deploy {
    width: 100%;
    max-width: 400px;
    padding: 6px;
    background: #fff;
    border: 1px solid #e6e9ef;
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 24px 48px -30px rgba(15, 23, 42, 0.35);
    color: #111827;
    font-family: var(--font);
  }

  /* header */
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 14px 16px;
  }

  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #111827;
    color: #fff;
  }

  .mark svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .title {
    display: grid;
    min-width: 0;
  }

  .title strong {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .title small {
    overflow: hidden;
    color: #6b7280;
    font-size: 12.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .state {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 4px 10px 4px 9px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .state i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .state[data-state="building"] {
    background: #fef6e7;
    color: #b45309;
  }

  .state[data-state="building"] i {
    animation: blink 1s ease-in-out infinite;
  }

  .state[data-state="ready"] {
    background: #e9f8ef;
    color: #15803d;
  }

  /* steps */
  .steps {
    margin: 0;
    padding: 6px 0;
    list-style: none;
    background: #fafbfc;
    border: 1px solid #eef0f4;
    border-radius: 10px;
  }

  .steps li {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    transition: opacity 0.3s ease;
  }

  .steps li[data-state="idle"] {
    opacity: 0.4;
  }

  .icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1.5px solid #d1d5db;
    border-radius: 50%;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  [data-state="active"] .icon {
    border-color: #e5e7eb;
    border-top-color: #111827;
    animation: spin 0.8s linear infinite;
  }

  [data-state="done"] .icon {
    background: #111827;
    border-color: #111827;
  }

  .check {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
  }

  [data-state="done"] .check {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.3s ease 0.05s;
  }

  .label {
    display: grid;
    font-size: 14px;
    font-weight: 500;
  }

  .label small {
    color: #9ca3af;
    font: 11.5px var(--mono);
  }

  .time {
    color: #9ca3af;
    font: 12px var(--mono);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  [data-state="done"] .time {
    opacity: 1;
  }

  /* footer */
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 14px 10px;
    font-size: 13px;
  }

  .domain {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #374151;
    font-family: var(--mono);
    font-size: 12px;
  }

  .domain i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .visit {
    color: #111827;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  /* While a deployment is running, the domain isn't live yet. */
  .deploy:global(.is-building) .domain i {
    background: #d1d5db;
    box-shadow: none;
  }

  .deploy:global(.is-building) .visit {
    color: #c0c5cd;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes blink {
    50% { opacity: 0.3; }
  }
</style>
