---
// Hero illustration: a small cloud setup drawn in isometric view.
// On load the parts drop in one by one and the connections appear. Then requests travel
// as light streaks: users → load balancer → pod → database, and the response returns in green.
// Each part lights up as traffic reaches it; the two pods take turns.
// Paused when off-screen; with reduced motion the diagram stays still.

type Box = { id: string; cx: number; cy: number; a: number; h: number; tone: "base" | "accent" | "green" };

// Top-face rhombus + two side faces for an isometric box centred at (cx, cy).
const faces = ({ cx, cy, a, h }: Box) => {
  const b = Math.round(a * 0.577);
  const top = `${cx},${cy - b} ${cx + a},${cy} ${cx},${cy + b} ${cx - a},${cy}`;
  const left = `${cx - a},${cy} ${cx},${cy + b} ${cx},${cy + b + h} ${cx - a},${cy + h}`;
  const right = `${cx},${cy + b} ${cx + a},${cy} ${cx + a},${cy + h} ${cx},${cy + b + h}`;
  return { top, left, right, b };
};

const boxes: Box[] = [
  { id: "lb", cx: 260, cy: 128, a: 62, h: 16, tone: "accent" },
  { id: "podA", cx: 168, cy: 226, a: 54, h: 30, tone: "base" },
  { id: "podB", cx: 352, cy: 226, a: 54, h: 30, tone: "base" },
];

const labels = [
  { x: 335, y: 112, title: "Load balancer", sub: "HTTPS · TLS", delay: 0.55 },
  { x: 40, y: 292, title: "api · pod", sub: "Kubernetes", delay: 0.75 },
  { x: 384, y: 292, title: "api · pod", sub: "Kubernetes", delay: 0.85 },
  { x: 112, y: 366, title: "PostgreSQL", sub: "managed database", delay: 1.0 },
];

// Connections run from the edge of one part to the edge of the next, so every hop is visible.
const links = {
  uLb: "M260 48 L260 94",
  lbA: "M229 163 C214 178 204 192 196 209",
  lbB: "M291 163 C306 178 316 192 324 209",
  aDb: "M196 273 C206 296 222 314 240 326",
  bDb: "M324 273 C314 296 298 314 280 326",
};

// Reverse a "M x y C ... x y" / "M x y L x y" path so a response can travel back up.
const reverse = (d: string) => {
  const n = d.match(/-?\d+(\.\d+)?/g)!.map(Number);
  const pts: number[][] = [];
  for (let i = 0; i < n.length; i += 2) pts.push([n[i], n[i + 1]]);
  pts.reverse();
  const [first, ...rest] = pts;
  return d.includes("C")
    ? `M${first.join(" ")} C${rest.map((p) => p.join(" ")).join(" ")}`
    : `M${first.join(" ")} L${rest[0].join(" ")}`;
};

// One request's journey, as fractions of the cycle: request hops down, the database
// works, the response hops back up. Two routes take turns, half a cycle apart.
const routes = [
  { pod: "A", offset: 0, request: "GET /orders", response: "200 OK · 38 ms" },
  { pod: "B", offset: 0.5, request: "GET /products", response: "200 OK · 41 ms" },
];

const beams = routes.flatMap((route) => {
  const toPod = route.pod === "A" ? links.lbA : links.lbB;
  const toDb = route.pod === "A" ? links.aDb : links.bDb;
  return [
    { d: links.uLb, at: 0.0, kind: "request" },
    { d: toPod, at: 0.1, kind: "request" },
    { d: toDb, at: 0.2, kind: "request" },
    { d: reverse(toDb), at: 0.36, kind: "response" },
    { d: reverse(toPod), at: 0.46, kind: "response" },
    { d: reverse(links.uLb), at: 0.56, kind: "response" },
  ].map((beam) => ({ ...beam, at: beam.at + route.offset }));
});

// Moments when a part lights up (a request or response reaches it).
const hits = routes.flatMap((route) => [
  { node: "lb", at: route.offset + 0.08 },
  { node: "lb", at: route.offset + 0.54 },
  { node: `pod${route.pod}`, at: route.offset + 0.18 },
  { node: `pod${route.pod}`, at: route.offset + 0.44 },
  { node: "db", at: route.offset + 0.28, long: true },
  { node: "users", at: route.offset + 0.64 },
]);

const tagWidth = (text: string) => Math.round(text.length * 6.4 + 16);
---

<div class="infra" data-play data-infra>
  <svg viewBox="0 0 520 460" role="img" aria-labelledby="infra-title infra-desc">
    <title id="infra-title">Example cloud setup</title>
    <desc id="infra-desc">Users reach a load balancer, which routes requests to two Kubernetes pods backed by a PostgreSQL database, with monitoring.</desc>

    <defs>
      <linearGradient id="g-floor" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.9" />
        <stop offset="1" stop-color="#eef3fb" stop-opacity="0.75" />
      </linearGradient>
      <pattern id="g-grid" width="24" height="14" patternUnits="userSpaceOnUse" patternTransform="skewX(-60)">
        <path d="M24 0 L0 0 0 14" fill="none" stroke="#c9d7e8" stroke-width="0.6" />
      </pattern>
      <clipPath id="c-floor">
        <polygon points="260,96 486,226 260,356 34,226" />
      </clipPath>
    </defs>

    <!-- floor -->
    <g class="part floor" style="--d: 0s">
      <polygon points="260,96 486,226 260,356 34,226" fill="url(#g-floor)" stroke="#d6e1ee" />
      <rect x="0" y="80" width="520" height="300" fill="url(#g-grid)" clip-path="url(#c-floor)" opacity="0.7" />
    </g>

    <!-- connections (tracks) and the light streaks that travel along them -->
    <g class="links">
      {Object.values(links).map((d, i) => (
        <path d={d} class="link" style={`--d: ${1.2 + i * 0.1}s`} />
      ))}
    </g>

    <g class="flow">
      {beams.map((beam) => (
        <g class:list={["beam", `beam-${beam.kind}`]} style={`--at: ${beam.at}`}>
          <path d={beam.d} pathLength="1" class="beam-glow" />
          <path d={beam.d} pathLength="1" class="beam-core" />
          <path d={beam.d} pathLength="1" class="beam-light" />
        </g>
      ))}
    </g>

    <!-- users -->
    <g class="part node-users" style="--d: 0.2s">
      {hits.filter((hit) => hit.node === "users").map((hit) => (
        <circle cx="260" cy="30" r="22" class="hit hit-response" style={`--at: ${hit.at}`} />
      ))}
      <circle cx="260" cy="30" r="17" fill="#ffffff" stroke="#c9d7e8" />
      <path d="M249 30 h22 M260 19 c-6 6 -6 16 0 22 M260 19 c6 6 6 16 0 22 M251 24 h18 M251 36 h18" fill="none" stroke="#5b6cff" stroke-width="1.4" stroke-linecap="round" />
      <text x="292" y="34" class="t-small">users</text>
    </g>

    <!-- boxes -->
    {boxes.map((box, i) => {
      const f = faces(box);
      return (
        <g class:list={["part", "box", `tone-${box.tone}`]} style={`--d: ${0.4 + i * 0.15}s`} data-node={box.id}>
          <polygon class="face-left" points={f.left} />
          <polygon class="face-right" points={f.right} />
          <polygon class="face-top" points={f.top} />
          {hits.filter((hit) => hit.node === box.id).map((hit) => (
            <polygon class="hit" points={f.top} style={`--at: ${hit.at}`} />
          ))}
          {box.id === "lb" ? (
            <g class="glyph" transform={`translate(${box.cx - 16} ${box.cy - 4})`}>
              <rect width="32" height="8" rx="4" fill="#ffffff" opacity="0.9" />
              <circle cx="6" cy="4" r="2" fill="#7c6cff" />
              <circle cx="14" cy="4" r="2" fill="#5b98de" />
              <circle cx="22" cy="4" r="2" fill="#3fb8a8" />
            </g>
          ) : (
            <g class="glyph" transform={`translate(${box.cx - 9} ${box.cy - 9}) scale(0.75)`}>
              <path fill="#326ce5" d="M12 1.5 21.6 6v12L12 22.5 2.4 18V6z" />
              <circle cx="12" cy="12" r="4.2" fill="none" stroke="#fff" stroke-width="1.6" />
              <path d="M12 5.2v2.6M12 16.2v2.6M5.6 9l2.3 1.3M16.1 13.7l2.3 1.3M5.6 15l2.3-1.3M16.1 10.3 18.4 9" stroke="#fff" stroke-width="1.4" stroke-linecap="round" />
            </g>
          )}
        </g>
      );
    })}

    <!-- database (cylinder) -->
    <g class="part box tone-green" style="--d: 0.85s" data-node="db">
      <path class="face-left" d="M222 336 v34 a38 14 0 0 0 76 0 v-34" />
      <ellipse class="face-top" cx="260" cy="336" rx="38" ry="14" />
      <ellipse cx="260" cy="336" rx="22" ry="7" fill="none" stroke="#9cc9ad" />
      {hits.filter((hit) => hit.node === "db").map((hit) => (
        <ellipse cx="260" cy="336" rx="38" ry="14" class="hit hit-long" style={`--at: ${hit.at}`} />
      ))}
    </g>

    <!-- labels -->
    {labels.map((label) => (
      <g class="part label" style={`--d: ${label.delay}s`}>
        <text x={label.x} y={label.y} class="t-title">{label.title}</text>
        <text x={label.x} y={label.y + 15} class="t-small">{label.sub}</text>
      </g>
    ))}

    <!-- request / response tags beside the users link -->
    {routes.map((route) => {
      const w = tagWidth(route.request);
      const r = tagWidth(route.response);
      return (
        <>
          <g class="tag tag-request" style={`--at: ${route.offset}`}>
            <rect x={248 - w} y="62" width={w} height="22" rx="11" />
            <text x={248 - w / 2} y="77" text-anchor="middle">{route.request}</text>
          </g>
          <g class="tag tag-response" style={`--at: ${route.offset + 0.63}`}>
            <rect x="272" y="62" width={r} height="22" rx="11" />
            <text x={272 + r / 2} y="77" text-anchor="middle">{route.response}</text>
          </g>
        </>
      );
    })}
  </svg>

  <!-- floating cards -->
  <div class="chip chip-deploy">
    <span class="chip-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.5 10.5 8v7.5L4 12zM11.5 8 18 4.5V12l-6.5 3.5zM11 16.5l6.5-3.5v7.5L11 24z" fill="currentColor" transform="translate(0 -1.5)" /></svg>
    </span>
    <span><strong>terraform apply</strong><small>infrastructure as code</small></span>
    <span class="chip-ok">✓</span>
  </div>

  <div class="chip chip-monitor">
    <span><strong>Monitoring</strong><small>Prometheus · Grafana</small></span>
    <svg class="spark" viewBox="0 0 90 30" aria-hidden="true">
      <g class="spark-scroll">
        <path class="spark-area" d="M0 22 L10 18 L20 20 L30 13 L40 16 L50 10 L60 14 L70 9 L80 15 L90 22 L100 18 L110 20 L120 13 L130 16 L140 10 L150 14 L160 9 L170 15 L180 22 L180 30 L0 30Z" />
        <path class="spark-line" d="M0 22 L10 18 L20 20 L30 13 L40 16 L50 10 L60 14 L70 9 L80 15 L90 22 L100 18 L110 20 L120 13 L130 16 L140 10 L150 14 L160 9 L170 15 L180 22" />
      </g>
      <circle class="spark-dot" cx="88" cy="21" r="2.5" />
    </svg>
  </div>
</div>

<script>
  // The data flow is pure CSS; pause it while the map is off-screen.
  const map = document.querySelector<HTMLElement>("[data-infra]");
  if (map) {
    new IntersectionObserver(([entry]) => {
      map.classList.toggle("is-offscreen", !entry.isIntersecting);
    }).observe(map);
  }
</script>

<style>
  .infra {
    position: relative;
    width: 100%;
    max-width: 580px;
    margin-inline: auto;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font);
  }

  .face-top { fill: #ffffff; stroke: #d3dfec; stroke-width: 1; }
  .face-left { fill: #e4ecf6; stroke: #d3dfec; stroke-width: 1; }
  .face-right { fill: #d2dfee; stroke: #c7d6e8; stroke-width: 1; }

  .tone-accent .face-top { fill: #f3f1ff; stroke: #c9c2ff; }
  .tone-accent .face-left { fill: #7c6cff; stroke: #7c6cff; }
  .tone-accent .face-right { fill: #5b4fe0; stroke: #5b4fe0; }

  .tone-green .face-top { fill: #f2faf5; stroke: #b9dcc6; }
  .tone-green .face-left { fill: #cfe8d9; stroke: #b9dcc6; }

  .box {
    filter: drop-shadow(0 14px 14px rgba(31, 48, 71, 0.12));
    transition: transform 0.3s ease;
  }

  .box:hover {
    transform: translateY(-4px);
  }

  .infra {
    --cycle: 6s;
    --start: 2.6s;
  }

  .link {
    fill: none;
    stroke: #dfe4f2;
    stroke-width: 3;
    stroke-linecap: round;
  }

  /* A light streak: one short dash that runs the length of the path. */
  .beam path {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 0.38 2;
    stroke-dashoffset: 0.38;
  }

  .beam-glow {
    stroke-width: 10;
    opacity: 0.3;
  }

  .beam-core {
    stroke-width: 3.5;
  }

  .beam .beam-light {
    stroke: #fff;
    stroke-width: 1.2;
  }

  .beam-request :is(.beam-glow, .beam-core) { stroke: #5b4fe0; }
  .beam-response :is(.beam-glow, .beam-core) { stroke: #10a37f; }

  .hit {
    fill: rgba(124, 108, 255, 0.18);
    stroke: #7c6cff;
    stroke-width: 2;
    opacity: 0;
  }

  ellipse.hit, .hit-response {
    fill: rgba(22, 163, 127, 0.14);
    stroke: #16a37f;
  }

  .tag rect {
    fill: #fff;
    stroke: #d6dcf5;
  }

  .tag text {
    font: 600 10.5px var(--mono);
  }

  .tag-request text { fill: #5b4fe0; }
  .tag-response text { fill: #12805f; }
  .tag-response rect { stroke: #bfe5d6; }

  .tag {
    opacity: 0;
  }

  .t-title {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 650;
  }

  .t-small {
    fill: #6b7f95;
    font: 11px var(--mono);
  }

  /* floating cards */
  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(201, 215, 232, 0.9);
    border-radius: 12px;
    box-shadow:
      0 1px 1px rgba(31, 48, 71, 0.04),
      0 18px 36px -18px rgba(50, 50, 93, 0.35),
      0 10px 20px -12px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(10px);
  }

  .chip strong {
    display: block;
    color: var(--ink);
    font-size: 13px;
    line-height: 1.25;
  }

  .chip small {
    color: #6b7f95;
    font: 11px var(--mono);
  }

  .chip-deploy {
    top: -4%;
    left: -4%;
  }

  .chip-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #844fba;
    color: #fff;
  }

  .chip-icon svg {
    width: 16px;
    height: 16px;
  }

  .chip-ok {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-left: 4px;
    border-radius: 50%;
    background: #3f9a6b;
    color: #fff;
    font-size: 11px;
  }

  .chip-monitor {
    right: -4%;
    bottom: 10%;
    padding-left: 14px;
  }

  .spark {
    width: 90px;
    height: 30px;
    overflow: hidden;
  }

  .spark-area { fill: rgba(124, 108, 255, 0.1); }

  .spark-line {
    fill: none;
    stroke: #7c6cff;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .spark-dot {
    fill: #7c6cff;
    stroke: #fff;
    stroke-width: 1.5;
  }

  /* Opening sequence: parts drop in, tracks appear, cards pop; the data flow starts after. */
  :global(.js-anim) .infra .part,
  :global(.js-anim) .infra .chip {
    opacity: 0;
  }

  :global(.js-anim) .infra .link {
    stroke-dashoffset: 60;
    opacity: 0;
  }

  .infra:global(.is-playing) .part {
    animation: part-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d, 0s) + 0.5s) both;
    transform-box: fill-box;
  }

  .infra:global(.is-playing) .link {
    animation: link-in 0.6s ease calc(var(--d, 0s) + 0.5s) both;
  }

  /* Data flow: every streak, glow and tag shares one cycle and starts at its own moment. */
  .infra:global(.is-playing) .beam path {
    animation: beam var(--cycle) linear calc(var(--start) + var(--cycle) * var(--at)) infinite backwards;
  }

  .infra:global(.is-playing) .hit {
    animation: hit var(--cycle) ease-out calc(var(--start) + var(--cycle) * var(--at)) infinite backwards;
  }

  .infra:global(.is-playing) .hit-long {
    animation-name: hit-long;
  }

  .infra:global(.is-playing) .tag {
    animation: tag var(--cycle) ease calc(var(--start) + var(--cycle) * var(--at)) infinite backwards;
  }

  .infra:global(.is-playing) .spark-scroll {
    animation: spark-scroll 6s linear 3s infinite;
  }

  .infra:global(.is-offscreen) * {
    animation-play-state: paused !important;
  }

  @keyframes beam {
    0% { stroke-dashoffset: 0.38; animation-timing-function: cubic-bezier(0.45, 0, 0.4, 1); }
    10% { stroke-dashoffset: -1; }
    100% { stroke-dashoffset: -1; }
  }

  @keyframes hit {
    0% { opacity: 0; }
    2% { opacity: 1; }
    12% { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes hit-long {
    0% { opacity: 0; }
    2% { opacity: 1; }
    9% { opacity: 1; }
    14% { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes tag {
    0% { opacity: 0; transform: translateY(4px); }
    3% { opacity: 1; transform: none; }
    13% { opacity: 1; transform: none; }
    17% { opacity: 0; transform: translateY(-3px); }
    100% { opacity: 0; }
  }

  @keyframes spark-scroll {
    to { transform: translateX(-90px); }
  }

  .infra:global(.is-playing) .chip-deploy {
    animation: chip-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 2.4s both;
  }

  .infra:global(.is-playing) .chip-monitor {
    animation: chip-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 2.7s both;
  }

  @keyframes part-in {
    from { opacity: 0; transform: translateY(-26px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes link-in {
    from { opacity: 0; }
    to { opacity: 0.85; }
  }

  @keyframes chip-in {
    from { opacity: 0; transform: translateY(12px) scale(0.95); }
    to { opacity: 1; transform: none; }
  }

  /* Small screens: the cards sit under the map instead of over it. */
  @media (max-width: 680px) {
    .infra {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }

    svg { flex: 0 0 100%; }

    .chip {
      position: static;
      flex: 1 1 160px;
    }

    .chip-ok, .spark { display: none; }
  }
</style>
